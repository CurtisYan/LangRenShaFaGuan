<view class="page detail-page" wx:if="{{board}}"><view class="detail-hero"><view class="eyebrow">板子规则</view><view class="title">{{board.name}}</view><view class="detail-summary">{{board.summary}}</view></view><view class="detail-section"><view class="section-label">基础设置</view><view class="setting-row"><text>游戏人数</text><text>{{board.playerCount}} 人</text></view><view class="setting-row"><text>警长</text><text>{{board.dayRules.sheriff ? '有警长 · 1.5 票' : '无警长'}}</text></view><view class="setting-row"><text>自曝规则</text><text>{{board.dayRules.exposure === 'single' ? '单曝吞警徽' : '双曝吞警徽'}}</text></view></view><view class="detail-section"><view class="section-label">夜间行动顺序</view><view class="flow-line"><text wx:for="{{nightActions}}" wx:key="*this" class="flow-chip">{{item}}</text></view></view><view class="detail-section"><view class="section-label">本板身份 · 点击查看角色说明</view><view class="role-grid"><view wx:for="{{roleCards}}" wx:key="id" class="role-card {{item.tone}}" data-id="{{item.id}}" bindtap="openRole"><view class="role-name">{{item.name}}</view><text>{{item.count}}</text></view></view></view><view wx:for="{{detailSections}}" wx:key="title" class="detail-section document-section"><view class="section-label">{{item.title}}</view><view wx:for="{{item.paragraphs}}" wx:key="*this" class="document-paragraph">{{item}}</view></view></view>
