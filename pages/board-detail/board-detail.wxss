.detail-page { padding-top: 48rpx; }
.detail-hero { margin: 0 4rpx 42rpx; }
.detail-summary { color: var(--color-ink-secondary); font-size: 28rpx; line-height: 1.6; }
.detail-section { margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid var(--color-border); }
.section-label { margin-bottom: 16rpx; color: var(--color-ink-muted); font-size: 22rpx; font-weight: 600; letter-spacing: .1em; }
.setting-row { display: flex; justify-content: space-between; gap: 30rpx; padding: 13rpx 0; color: var(--color-ink-secondary); font-size: 26rpx; }
.setting-row text:last-child { color: var(--color-ink); text-align: right; }
.flow-line { display: flex; flex-wrap: wrap; gap: 9rpx; }
.flow-chip { margin: 0; color: var(--color-accent); background: var(--color-selected); }
.rule-line { display: flex; gap: 12rpx; margin: 11rpx 0; color: var(--color-ink-secondary); font-size: 24rpx; line-height: 1.58; }
.rule-line text:first-child { color: #91a096; }
.document-section { margin-top: 34rpx; }
.document-paragraph { margin: 13rpx 0; color: var(--color-ink-secondary); font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; }
.role-card { display: flex; min-height: 88rpx; align-items: flex-start; justify-content: space-between; margin: 0; padding: 15rpx; }
.role-card.wolf { border-color: #ead7d4; background: var(--color-wolf-soft); }
.role-card.villager { border-color: #d7e2e7; background: var(--color-villager-soft); }
.role-card.god { border-color: #e6dfce; background: var(--color-god-soft); }
.role-card.third { border-color: #e1d8ea; background: var(--color-third-soft); }
.role-name { color: var(--color-ink); font-size: 28rpx; font-weight: 600; }
.role-card > text { color: var(--color-ink-secondary); font-size: 28rpx; }
