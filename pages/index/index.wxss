.home-page { display: flex; height: 100vh; min-height: 0; flex-direction: column; padding-top: 42rpx; padding-bottom: 0; overflow: hidden; }
.home-hero { flex: 0 0 auto; margin: 0 8rpx 34rpx; }
.home-intro { max-width: 530rpx; color: var(--color-ink-secondary); font-size: 28rpx; line-height: 1.7; }
.resume-panel {
  --color-surface: #27332f;
  --color-surface-soft: #35443e;
  --color-ink: #f6f5ed;
  --color-ink-secondary: #c8d0c9;
  --color-ink-muted: #aeb8b2;
  --color-border: rgba(255, 255, 255, .18);
  --color-primary: #f6f5ed;
  --color-primary-pressed: #e7e8e0;
  --color-on-primary: #27332f;
  flex: 0 0 auto;
  margin-bottom: 32rpx;
  color: var(--color-ink);
  background: var(--color-surface);
}
.resume-topline { display: flex; justify-content: space-between; color: var(--color-ink-secondary); font-size: 22rpx; letter-spacing: .08em; }
.resume-phase { color: var(--color-ink); }
.resume-board { margin: 14rpx 0 7rpx; font-size: 38rpx; font-weight: 600; letter-spacing: -.02em; }
.resume-actions { display: flex; gap: 14rpx; margin-top: 24rpx; }
.resume-actions button { flex: 1; }
.resume-actions .quiet-button { border-color: var(--color-border); color: var(--color-ink); }
.section-heading { position: relative; display: flex; flex: 0 0 auto; align-items: flex-end; justify-content: space-between; margin: 0 4rpx 12rpx; padding: 0 0 17rpx; border-bottom: 1rpx solid var(--color-border); }
.section-heading::after { position: absolute; left: 0; bottom: -1rpx; width: 72rpx; height: 3rpx; background: var(--color-ink); content: ''; }
.section-heading .eyebrow { margin-bottom: 5rpx; }
.section-heading .subtitle { margin: 0; font-size: 34rpx; }
.board-count { display: flex; align-items: baseline; gap: 7rpx; padding-bottom: 2rpx; color: var(--color-ink-muted); font-size: 20rpx; }
.board-count-number { color: var(--color-ink); font-size: 30rpx; font-weight: 600; }
.board-scroll { min-height: 0; flex: 1; }
.board-list { border-top: 0; }
.board-row { display: flex; min-height: 132rpx; align-items: center; justify-content: space-between; gap: 22rpx; padding: 22rpx 4rpx; }
.board-main { min-width: 0; flex: 1; }
.board-name { margin-bottom: 7rpx; font-size: 30rpx; font-weight: 600; }
.board-summary { overflow: hidden; color: var(--color-ink-muted); font-size: 24rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.board-side { flex: 0 0 72rpx; color: var(--color-ink-secondary); font-size: 22rpx; text-align: right; }
.board-enter { margin-top: 5rpx; color: var(--color-ink-muted); font-size: 30rpx; font-weight: 300; line-height: 1; }
.rule-entry { display: flex; flex: 0 0 auto; align-items: center; justify-content: space-between; gap: 20rpx; margin: 14rpx -30rpx 0; padding: 22rpx 30rpx calc(22rpx + env(safe-area-inset-bottom)); color: #f6f5ed; background: #27332f; }
.rule-entry-copy { min-width: 0; }
.rule-entry .eyebrow { margin-bottom: 5rpx; color: #aeb8b2; }
.rule-entry .subtitle { margin: 0; color: #f6f5ed; font-size: 30rpx; }
.rule-entry-note { margin-top: 6rpx; overflow: hidden; color: #aeb8b2; font-size: 20rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.rule-entry-side { display: flex; flex: 0 0 auto; align-items: center; gap: 11rpx; color: #f6f5ed; font-size: 22rpx; }
.rule-entry-arrow { font-size: 30rpx; font-weight: 300; line-height: 1; }
