.home-page { display: flex; height: 100vh; min-height: 0; flex-direction: column; padding-top: 42rpx; padding-bottom: 0; overflow: hidden; }
.home-hero { flex: 0 0 auto; margin: 0 8rpx 34rpx; }
.home-intro { max-width: 530rpx; color: var(--color-ink-secondary); font-size: 28rpx; line-height: 1.7; }
.resume-panel {
  --color-surface: #27332f;
  --color-surface-soft: #35443e;
  --color-ink: #f6f5ed;
  --color-ink-secondary: #c8d0c9;
  --color-ink-muted: #aeb8b2;
  --color-border: rgba(255, 255, 255, .18);
  --color-primary: #f6f5ed;
  --color-primary-pressed: #e7e8e0;
  --color-on-primary: #27332f;
  flex: 0 0 auto;
  margin-bottom: 32rpx;
  color: var(--color-ink);
  background: var(--color-surface);
}
.resume-topline { display: flex; justify-content: space-between; color: var(--color-ink-secondary); font-size: 22rpx; letter-spacing: .08em; }
.resume-phase { color: var(--color-ink); }
.resume-board { margin: 14rpx 0 7rpx; font-size: 38rpx; font-weight: 600; letter-spacing: -.02em; }
.resume-actions { display: flex; gap: 14rpx; margin-top: 24rpx; }
.resume-actions button { flex: 1; }
.resume-actions .quiet-button { border-color: var(--color-border); color: var(--color-ink); }
.section-heading { position: relative; display: flex; flex: 0 0 auto; align-items: flex-end; justify-content: space-between; margin: 0 4rpx 12rpx; padding: 0 0 17rpx; border-bottom: 1rpx solid var(--color-border); }
.section-heading::after { position: absolute; left: 0; bottom: -1rpx; width: 72rpx; height: 3rpx; background: var(--color-ink); content: ''; }
.section-heading .eyebrow { margin-bottom: 5rpx; }
.section-heading .subtitle { margin: 0; font-size: 34rpx; }
.board-count { display: flex; align-items: baseline; gap: 7rpx; padding-bottom: 2rpx; color: var(--color-ink-muted); font-size: 20rpx; }
.board-count-number { color: var(--color-ink); font-size: 30rpx; font-weight: 600; }
.board-tools { display: flex; align-items: center; gap: 16rpx; }
.board-tools .pin-manager-button { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0; border-color: transparent; border-radius: 50%; background: transparent; }
.pin-icon { flex: 0 0 auto; width: 38rpx; height: 38rpx; }
.pin-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; display: flex; align-items: flex-end; }
.pin-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(39, 51, 47, .32); animation: pin-backdrop-in .28s ease-out both; }
.pin-sheet { position: relative; box-sizing: border-box; display: flex; flex-direction: column; width: 100%; max-height: 85vh; padding: 30rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)); border: 1rpx solid var(--color-border); border-bottom: 0; border-radius: 28rpx 28rpx 0 0; background: var(--color-canvas); animation: pin-sheet-in .34s cubic-bezier(.16, 1, .3, 1) both; }
.pin-overlay.is-closing .pin-sheet { pointer-events: none; animation: pin-sheet-out .22s cubic-bezier(.4, 0, 1, 1) both; }
.pin-overlay.is-closing .pin-backdrop { animation: pin-backdrop-out .22s ease-in both; }
@keyframes pin-sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes pin-sheet-out { from { transform: translateY(0); } to { transform: translateY(100%); } }
@keyframes pin-backdrop-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes pin-backdrop-out { from { opacity: 1; } to { opacity: 0; } }
.pin-sheet-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20rpx; color: var(--color-ink-muted); font-size: 24rpx; }
.pin-sheet-heading .subtitle { margin: 0; color: var(--color-ink); }
.pin-options { height: 55vh; min-height: 0; }
.pin-option { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 88rpx; padding: 8rpx 12rpx; border-bottom: 1rpx solid var(--color-border); color: var(--color-ink); font-size: 28rpx; }
.pin-option.is-pinned { color: var(--color-accent-strong); background: var(--color-selected); }
.pin-choice-state { display: flex; flex: 0 0 auto; align-items: center; gap: 10rpx; }
.pin-order-space { width: 34rpx; }
.pin-order { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border-radius: 50%; color: var(--color-on-primary); background: var(--color-primary); font-size: 22rpx; font-weight: 600; }
.pin-option:not(.is-pinned) .pin-icon { opacity: .45; }
.pin-sheet-actions { display: flex; gap: 14rpx; padding-top: 24rpx; }
.pin-sheet-actions button { flex: 1; }
.board-scroll { width: calc(100% + 30rpx); min-height: 0; flex: 1; margin-right: -30rpx; }
.board-list { box-sizing: border-box; padding-right: 30rpx; border-top: 0; }
.board-row { display: flex; min-height: 132rpx; align-items: center; justify-content: space-between; gap: 22rpx; padding: 22rpx 4rpx; }
.board-main { min-width: 0; flex: 1; }
.board-name { display: flex; align-items: center; gap: 10rpx; margin-bottom: 7rpx; font-size: 30rpx; font-weight: 600; }
.board-pin-icon { flex: 0 0 auto; width: 28rpx; height: 28rpx; }
.board-summary { overflow: hidden; color: var(--color-ink-muted); font-size: 24rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.board-side { flex: 0 0 72rpx; color: var(--color-ink-secondary); font-size: 22rpx; text-align: right; }
.board-enter { margin-top: 5rpx; color: var(--color-ink-muted); font-size: 30rpx; font-weight: 300; line-height: 1; }
.rule-entry { display: flex; flex: 0 0 auto; align-items: center; justify-content: space-between; gap: 20rpx; margin: 14rpx -30rpx 0; padding: 22rpx 30rpx; color: #f6f5ed; background: #27332f; }
.rule-entry-copy { min-width: 0; }
.rule-entry .eyebrow { margin-bottom: 5rpx; color: #aeb8b2; }
.rule-entry .subtitle { margin: 0; color: #f6f5ed; font-size: 30rpx; }
.rule-entry-note { margin-top: 6rpx; overflow: hidden; color: #aeb8b2; font-size: 20rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.rule-entry-side { display: flex; flex: 0 0 auto; align-items: center; gap: 11rpx; color: #f6f5ed; font-size: 22rpx; }
.rule-entry-arrow { font-size: 30rpx; font-weight: 300; line-height: 1; }
