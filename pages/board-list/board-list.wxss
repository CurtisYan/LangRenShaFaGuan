.catalog-page { padding-top: 50rpx; }
.catalog-hero { margin: 0 5rpx 42rpx; }
.catalog-hero .muted { font-size: 26rpx; line-height: 1.6; }
.catalog-row { display: flex; min-height: 132rpx; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 3rpx; }
.catalog-main { min-width: 0; flex: 1; }
.catalog-main .subtitle { margin-bottom: 7rpx; font-size: 30rpx; }
.catalog-summary { overflow: hidden; color: var(--color-ink-muted); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.catalog-side { display: flex; align-items: center; gap: 15rpx; color: var(--color-ink-muted); font-size: 22rpx; }
.catalog-side text:last-child { color: var(--color-accent); font-size: 38rpx; font-weight: 300; }
