.role-list-page { padding-top: 50rpx; }.role-list-hero { margin: 0 5rpx 42rpx; }.role-list { border-top: 1rpx solid #d9dad2; }.role-list-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 88rpx; padding: 18rpx 2rpx; border-bottom: 1rpx solid #d9dad2; }.role-title { display: flex; align-items: center; gap: 9rpx; color: #303a33; font-size: 29rpx; font-weight: 600; }.tag { padding: 4rpx 10rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 500; }.wolf-tag { color: #86413c; background: #f4e7e5; }.villager-tag { color: #486982; background: #e8f0f4; }.god-tag { color: #7d5f28; background: #f5eddc; }.third-tag { color: #73598b; background: #eee9f4; }.role-enter { color: #64766b; font-size: 39rpx; font-weight: 300; }
