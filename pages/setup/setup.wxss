.setup-page { padding-top: 48rpx; }
.setup-header { margin: 0 4rpx 28rpx; }
.setup-header .eyebrow { margin-bottom: 10rpx; }
.setup-count { display: flex; justify-content: space-between; margin-top: 20rpx; color: var(--color-ink-secondary); font-size: 24rpx; }
.progress-track { height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 99rpx; background: var(--color-surface-soft); }
.progress-fill { height: 100%; border-radius: inherit; background: var(--color-accent-muted); transition: width .2s ease; }
.config-summary { padding: 22rpx 0 25rpx; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.summary-label { margin-bottom: 12rpx; color: var(--color-ink-muted); font-size: 22rpx; letter-spacing: .08em; }
.summary-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.summary-tag { margin: 0; }
.summary-tag.wolf { color: var(--color-wolf); background: var(--color-wolf-soft); }
.summary-tag.villager { color: var(--color-villager); background: var(--color-villager-soft); }
.summary-tag.god { color: var(--color-god); background: var(--color-god-soft); }
.summary-tag.third { color: var(--color-third); background: var(--color-third-soft); }
.first-night-identity-card { box-sizing: border-box; margin-top: 28rpx; padding: 27rpx 27rpx 25rpx; border: 1rpx solid #b9c8bf; border-left: 5rpx solid var(--color-accent-muted); border-radius: var(--radius-card); background: #f2f6f2; }
.identity-entry-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.identity-entry-kicker { margin-bottom: 8rpx; color: var(--color-accent); font-size: 22rpx; font-weight: 600; letter-spacing: .1em; }
.identity-entry-title { color: var(--color-ink); font-size: 34rpx; font-weight: 600; }
.identity-entry-arrow { color: var(--color-accent); font-size: 46rpx; line-height: 1; }
.identity-entry-copy { margin-top: 18rpx; color: var(--color-ink-secondary); font-size: 24rpx; line-height: 1.68; }
.identity-entry-note { margin-top: 17rpx; padding-top: 15rpx; border-top: 1rpx solid #d7e0da; color: var(--color-ink-muted); font-size: 22rpx; line-height: 1.5; }
.setup-divider { display: flex; align-items: center; gap: 18rpx; margin: 30rpx 0 0; color: var(--color-ink-muted); font-size: 22rpx; }
.setup-divider::before, .setup-divider::after { content: ''; flex: 1; height: 1rpx; background: var(--color-border); }
.mode-switch { margin: 30rpx 0 22rpx; }
.instruction { margin: 0 4rpx 24rpx; font-size: 24rpx; line-height: 1.55; }
.camp-heading { display: flex; align-items: center; gap: 10rpx; margin: 32rpx 2rpx 14rpx; font-size: 28rpx; font-weight: 600; }
.camp-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.camp-dot.wolf { background: var(--color-wolf); }
.camp-dot.good { background: var(--color-villager); }
.camp-dot.third { background: var(--color-third); }
.number-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.role-card, .number-card { min-height: 112rpx; border: 1rpx solid var(--color-border); background: var(--color-surface); }
.role-card { padding: 15rpx 16rpx; }
.role-card-top { display: flex; align-items: baseline; justify-content: space-between; gap: 8rpx; font-size: 28rpx; font-weight: 600; }
.role-count { color: var(--color-ink-muted); font-size: 22rpx; font-weight: 400; }
.role-card.selected { box-shadow: inset 0 0 0 1rpx currentColor; }
.role-card.wolf.selected { border-color: var(--color-wolf); color: var(--color-wolf); background: var(--color-wolf-soft); }
.role-card.villager.selected { border-color: var(--color-villager); color: var(--color-villager); background: var(--color-villager-soft); }
.role-card.god.selected { border-color: var(--color-god); color: var(--color-god); background: var(--color-god-soft); }
.role-card.third.selected { border-color: var(--color-third); color: var(--color-third); background: var(--color-third-soft); }
.role-numbers, .number-role { margin-top: 9rpx; color: var(--color-ink-muted); font-size: 22rpx; line-height: 1.35; }
.seat-section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 38rpx 2rpx 14rpx; }
.seat-section-heading .subtitle { margin: 0; }
.seat-section-heading .muted { font-size: 22rpx; }
.number-card { box-sizing: border-box; min-height: 100rpx; padding: 15rpx 8rpx; border-radius: 14rpx; text-align: center; }
.seat-number { color: var(--color-ink); font-size: 32rpx; font-weight: 600; line-height: 1; }
.seat-number text { margin-left: 2rpx; font-size: 20rpx; font-weight: 400; }
.number-card.assigned-seat { border-color: #c7d2cb; background: #f3f6f2; }
.number-card.assigned-seat .number-role { color: var(--color-accent); }
.number-card.selected-role, .number-card.selected-seat { border-color: var(--color-accent); background: var(--color-selected); box-shadow: inset 0 0 0 1rpx var(--color-accent); }
.config-error { margin-top: 28rpx; padding: 20rpx; border-left: 4rpx solid var(--color-danger); color: var(--color-danger); background: var(--color-danger-soft); font-size: 24rpx; line-height: 1.55; }
.setup-actions { display: flex; gap: 14rpx; margin-top: 34rpx; }
.setup-actions button { flex: 1; }
