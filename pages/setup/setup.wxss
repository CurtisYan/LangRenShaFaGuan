.setup-page { padding-top: 48rpx; }
.setup-header { margin: 0 4rpx 28rpx; }
.setup-header .eyebrow { margin-bottom: 10rpx; }
.setup-count { display: flex; justify-content: space-between; margin-top: 20rpx; color: #667067; font-size: 24rpx; }
.progress-track { height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 99rpx; background: #e2e3dc; }
.progress-fill { height: 100%; border-radius: inherit; background: #647a70; transition: width .2s ease; }
.config-summary { padding: 22rpx 0 25rpx; border-top: 1rpx solid #d9dad2; border-bottom: 1rpx solid #d9dad2; }
.summary-label { margin-bottom: 12rpx; color: #737970; font-size: 23rpx; letter-spacing: .08em; }
.summary-tags { display: flex; flex-wrap: wrap; gap: 9rpx; }
.summary-tag { padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 23rpx; }
.summary-tag.wolf { color: #87413d; background: #f4e8e6; }
.summary-tag.good { color: #486a83; background: #e9f0f4; }
.summary-tag.third { color: #765b93; background: #eee9f4; }
.mode-switch { display: flex; margin: 30rpx 0 22rpx; padding: 5rpx; border-radius: 14rpx; background: #e8e9e3; }
.mode-item { flex: 1; padding: 15rpx 8rpx; border-radius: 10rpx; color: #697067; font-size: 25rpx; text-align: center; }
.mode-item.active { color: #24302c; background: #fffefa; box-shadow: 0 2rpx 8rpx rgba(30, 38, 34, .08); font-weight: 600; }
.instruction { margin: 0 4rpx 24rpx; font-size: 24rpx; line-height: 1.55; }
.camp-heading { display: flex; align-items: center; gap: 10rpx; margin: 32rpx 2rpx 14rpx; font-size: 28rpx; font-weight: 600; }
.camp-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.camp-dot.wolf { background: #a34e49; }
.camp-dot.good { background: #5d788f; }
.camp-dot.third { background: #80649d; }
.role-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.number-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.role-card, .number-card { box-sizing: border-box; min-height: 112rpx; border: 1rpx solid #dedfd8; border-radius: 14rpx; background: #fffefa; }
.role-card { padding: 15rpx 16rpx; }
.role-card-top { display: flex; align-items: baseline; justify-content: space-between; gap: 8rpx; font-size: 27rpx; font-weight: 600; }
.role-count { color: #888d84; font-size: 22rpx; font-weight: 400; }
.role-card.selected { border: 2rpx solid #465a51; background: #f0f4ef; box-shadow: inset 0 0 0 2rpx rgba(70, 90, 81, .08); }
.role-card.wolf.selected { border-color: #9a514b; background: #f8efed; }
.role-card.good.selected { border-color: #58748a; background: #eef4f7; }
.role-card.third.selected { border-color: #80649d; background: #f3eff8; }
.role-numbers, .number-role { margin-top: 9rpx; color: #777d74; font-size: 21rpx; line-height: 1.35; }
.seat-section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 38rpx 2rpx 14rpx; }
.seat-section-heading .subtitle { margin: 0; }
.seat-section-heading .muted { font-size: 22rpx; }
.number-card { min-height: 100rpx; padding: 15rpx 8rpx; text-align: center; }
.seat-number { color: #2e3834; font-size: 32rpx; font-weight: 600; line-height: 1; }
.seat-number text { margin-left: 2rpx; font-size: 19rpx; font-weight: 400; }
.number-card.assigned-seat { border-color: #d1dad4; background: #f3f6f2; }
.number-card.assigned-seat .number-role { color: #63766a; }
.number-card.selected-role { border: 2rpx solid #60766c; background: #f1f5f0; }
.number-card.selected-seat { border: 2rpx solid #354b42; background: #e8f0eb; box-shadow: inset 0 0 0 2rpx rgba(53, 75, 66, .08); }
.config-error { margin-top: 28rpx; padding: 20rpx; border-left: 4rpx solid #a34e49; color: #95443f; background: #faefed; font-size: 25rpx; line-height: 1.55; }
.setup-actions { display: flex; gap: 14rpx; margin-top: 34rpx; }
.setup-actions button { flex: 1; }
.text-button { border-color: transparent; color: #72786f; background: transparent; }
