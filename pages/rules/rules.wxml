<view class="page">
  <view class="title">板子规则</view>
  <view wx:for="{{boards}}" wx:key="id" class="card">
    <view class="subtitle">{{item.name}}</view>
    <view class="muted">{{item.summary}}</view>
    <view wx:for="{{item.rules}}" wx:for-item="rule" wx:key="*this" class="rule">• {{rule}}</view>
  </view>
  <view class="title">角色说明</view>
  <view wx:for="{{roleList}}" wx:key="id" class="card">
    <view class="subtitle">{{item.name}} <text class="tag {{item.tagClass}}">{{item.group}}</text></view>
    <view>{{item.description}}</view>
  </view>
</view>
