.game-page { padding-top: 42rpx; }
.game-topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 22rpx; margin-bottom: 32rpx; }
.game-topbar .eyebrow { margin-bottom: 7rpx; }
.game-title { font-size: 52rpx; line-height: 1; font-weight: 650; letter-spacing: -.04em; }
.game-title text { margin-left: 4rpx; font-size: 27rpx; font-weight: 500; letter-spacing: 0; }
.board-stamp { max-width: 250rpx; padding-top: 7rpx; color: #70776e; font-size: 23rpx; line-height: 1.45; text-align: right; }
.safety-guard { margin: -10rpx 0 28rpx; }
.hold-action { position: relative; display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; overflow: hidden; padding: 0 18rpx; border: 1rpx solid #ccd5ce; border-radius: 14rpx; color: #44564b; background: #f4f7f3; }
.hold-action.disabled { border-color: #e0e2dc; color: #989d95; background: #f2f2ed; }
.hold-copy, .hold-arrow, .hold-mini { position: relative; z-index: 1; }
.hold-copy { display: flex; flex-direction: column; gap: 2rpx; font-size: 25rpx; font-weight: 600; }
.hold-copy text:last-child { color: #798379; font-size: 19rpx; font-weight: 400; }
.hold-arrow { color: #809084; font-size: 36rpx; font-weight: 300; }
.hold-ripple, .pill-ripple { position: absolute; z-index: 0; left: 50%; top: 50%; width: 18rpx; height: 18rpx; border-radius: 50%; opacity: 0; pointer-events: none; transform: translate(-50%, -50%) scale(.2); background: rgba(88, 120, 101, .28); }
.hold-action.armed .hold-ripple, .withdraw-pill.armed .pill-ripple { animation: hold-spread .85s ease-out; }
.hold-hint { min-height: 28rpx; margin: 8rpx 4rpx 0; color: #778076; font-size: 21rpx; line-height: 1.35; }
@keyframes hold-spread { 0% { opacity: .9; transform: translate(-50%, -50%) scale(.2); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(28); } }
.is-night { background: #1d2421; color: #f1f2ec; }
.is-night .eyebrow, .is-night .board-stamp, .is-night .muted { color: #aeb8b0; }
.is-night .hold-action { border-color: rgba(230, 235, 227, .18); color: #dbe5db; background: rgba(240, 244, 237, .08); }
.is-night .hold-action.disabled { color: #859188; background: rgba(240, 244, 237, .04); }
.is-night .hold-copy text:last-child, .is-night .hold-hint { color: #aeb8b0; }
.is-night .game-topbar { margin-bottom: 38rpx; }
.settlement-panel, .result-panel { padding: 34rpx 30rpx; border-radius: 22rpx; background: #fffefa; box-shadow: 0 14rpx 38rpx rgba(26, 34, 30, .08); }
.settlement-panel { border: 1rpx solid #d8d9d1; }
.settlement-panel .eyebrow { color: #756283; }
.skill-question { margin: 20rpx 0 28rpx; font-size: 40rpx; line-height: 1.45; font-weight: 600; letter-spacing: -.02em; }
.settlement-action { width: 100%; margin-top: 24rpx; }
.unavailable-skill { color: #72786f; font-size: 25rpx; }
.unavailable-skill button { width: 100%; margin-top: 16rpx; }
.result-panel { border: 1rpx solid #b9d4c3; background: #f0f7f1; }
.result-panel .title { margin-bottom: 12rpx; color: #365b46; }
.night-console { overflow: hidden; border: 1rpx solid rgba(230, 235, 227, .16); border-radius: 22rpx; background: #252e2a; }
.console-heading { display: flex; align-items: flex-end; justify-content: space-between; padding: 26rpx 26rpx 22rpx; border-bottom: 1rpx solid rgba(230, 235, 227, .12); }
.console-heading .subtitle { margin: 0; color: #f1f2ec; }
.console-note { color: #b6c0b8; font-size: 22rpx; }
.host-sheet { padding: 6rpx 26rpx 10rpx; }
.host-line { display: flex; gap: 16rpx; color: #eef0e9; font-size: 33rpx; line-height: 1.58; font-weight: 500; }
.main-line { padding: 24rpx 0 18rpx; font-size: 39rpx; font-weight: 600; }
.line-number { flex: 0 0 32rpx; padding-top: 7rpx; color: #94a299; font-size: 19rpx; font-weight: 600; line-height: 1; letter-spacing: .06em; }
.script-step { padding: 24rpx 0 22rpx; border-top: 1rpx solid rgba(230, 235, 227, .12); }
.script-step.last-step { padding-bottom: 26rpx; }
.script-note { margin: 10rpx 0 0 48rpx; color: #b3bcb5; font-size: 24rpx; }
.host-closure { margin: 17rpx 0 0 48rpx; color: #b7c0b9; font-size: 27rpx; }
.inline-entry { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin: 18rpx 0 0 48rpx; color: #c5cdc6; font-size: 25rpx; }
.inline-picker { min-width: 138rpx; padding: 9rpx 14rpx; border-bottom: 1rpx solid #b6c4bb; color: #f4f4ed; text-align: center; }
.note { margin: 16rpx 0 0 48rpx; font-size: 24rpx; line-height: 1.55; }
.inspection-inline { padding: 7rpx 11rpx; border-radius: 8rpx; color: #f0dfb3; background: rgba(207, 168, 92, .14); font-size: 23rpx; font-weight: 600; }
.witch-entry { display: block; }
.witch-entry picker { display: inline-block; margin: 0 12rpx 10rpx 0; }
.resource-line { color: #acb7af; font-size: 23rpx; }
.is-night .finish-button { width: 100%; margin-top: 22rpx; border-color: #edf0e9; color: #22302b; background: #edf0e9; }
.day-console { border-top: 1rpx solid #dadbd3; }
.day-head { position: relative; display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 25rpx 4rpx 24rpx; border-bottom: 1rpx solid #dadbd3; }
.day-head .eyebrow { margin-bottom: 8rpx; }
.day-head .subtitle { margin-bottom: 6rpx; font-size: 37rpx; }
.narration { color: #747a71; font-size: 25rpx; }
.self-expose { flex: 0 0 auto; min-height: 56rpx; padding: 0 15rpx; border-color: #bb726a; border-radius: 10rpx; color: #984641; background: #fff8f6; font-size: 22rpx; line-height: 54rpx; }
.notice-bar { margin: 20rpx 0; padding: 17rpx 19rpx; border-left: 4rpx solid #b1813d; color: #805e2c; background: #faf4e8; font-size: 25rpx; line-height: 1.55; }
.claw-button { width: 100%; margin-bottom: 20rpx; border-color: #8d4943; color: #fff9f7; background: #8d4943; }
.stage-panel { position: relative; margin: 22rpx 0; padding: 28rpx; border: 1rpx solid #deded7; border-radius: 20rpx; background: #fffefa; }
.stage-kicker { margin-bottom: 11rpx; color: #7e897f; font-size: 21rpx; font-weight: 600; letter-spacing: .13em; }
.stage-panel .subtitle { margin-bottom: 10rpx; font-size: 34rpx; }
.stage-copy { color: #70776e; font-size: 25rpx; line-height: 1.58; }
.night-result-copy { margin: 18rpx 0; color: #38443e; font-size: 37rpx; line-height: 1.45; font-weight: 600; }
.full-action { width: 100%; margin-top: 24rpx; }
.seat-pills, .voter-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 22rpx 0; }
.seat-pill, .voter { display: flex; align-items: center; justify-content: center; min-width: 84rpx; min-height: 64rpx; padding: 0 13rpx; border: 1rpx solid #d8d9d2; border-radius: 10rpx; color: #4d554e; background: #fffefa; font-size: 25rpx; }
.seat-pill.chosen, .voter.selected { border: 2rpx solid #50695d; color: #2f493d; background: #ecf3ed; font-weight: 600; }
.withdraw-pill { position: relative; gap: 7rpx; overflow: hidden; }
.withdraw-pill.armed { border-color: #a9864a; color: #6d5324; background: #fbf3df; }
.hold-mini { color: #849088; font-size: 18rpx; font-weight: 400; }
.withdraw-pill.armed .hold-mini { color: #8b6d35; }
.vote-stage .picker { margin-top: 16rpx; }
.vote-ledger { margin-top: 18rpx; border-top: 1rpx solid #ecece6; }
.vote-row { display: flex; justify-content: space-between; padding: 11rpx 2rpx; border-bottom: 1rpx solid #ecece6; color: #586159; font-size: 25rpx; }
.tally-row { color: #2f3933; font-weight: 600; }
.sheriff-star { border-color: #d6b26b; color: #79581e; background: #fbf1d7; clip-path: polygon(50% 0%, 61% 31%, 95% 31%, 68% 50%, 79% 85%, 50% 64%, 21% 85%, 32% 50%, 5% 31%, 39% 31%); }
.sheriff-record { color: #89652b; font-weight: 600; }
.mode-switch { display: flex; margin: 20rpx 0 18rpx; padding: 5rpx; border-radius: 13rpx; background: #e8e9e3; }
.mode-item { flex: 1; padding: 13rpx 8rpx; border-radius: 9rpx; color: #6d756c; font-size: 24rpx; text-align: center; }
.mode-item.active { color: #28362f; background: #fffefa; box-shadow: 0 2rpx 8rpx rgba(30, 38, 34, .08); font-weight: 600; }
.record-button { width: 100%; margin-top: 16rpx; }
.tally-title { margin-top: 26rpx; color: #475149; font-size: 25rpx; font-weight: 600; }
.vote-input { box-sizing: border-box; width: 100%; margin: 16rpx 0 0; padding: 18rpx; border: 1rpx solid #d8d9d1; border-radius: 12rpx; background: #fffefa; font-size: 27rpx; }
.game-reference { margin-top: 44rpx; }
.log-panel, .seat-panel, .vote-history { padding: 27rpx 0; border-top: 1rpx solid #d8d9d1; }
.log-panel { max-height: 350rpx; overflow: hidden; }
.panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 17rpx; }
.panel-heading .subtitle { margin-bottom: 4rpx; }
.panel-heading > text { padding-top: 6rpx; color: #7d837b; font-size: 22rpx; }
.log-item { padding: 11rpx 2rpx; border-bottom: 1rpx solid #e6e6df; color: #6d746c; font-size: 24rpx; line-height: 1.5; }
.seat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.seat-tile { min-height: 122rpx; padding: 14rpx 13rpx; border: 1rpx solid #dedfd8; border-radius: 14rpx; background: #fffefa; }
.seat-tile.dead { color: #969b94; background: #f0f0eb; }
.seat-tile-top { display: flex; align-items: baseline; justify-content: space-between; gap: 6rpx; }
.seat-tile-number { color: #2e3933; font-size: 31rpx; font-weight: 600; }
.seat-tile.dead .seat-tile-number { color: #8c928a; }
.seat-tile-number text { margin-left: 1rpx; font-size: 18rpx; font-weight: 400; }
.seat-state { color: #788178; font-size: 19rpx; }
.seat-role { overflow: hidden; margin-top: 9rpx; color: #5d655d; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.seat-marks { min-height: 28rpx; margin-top: 7rpx; }
.water-tag { display: inline-block; margin-right: 4rpx; padding: 3rpx 8rpx; border-radius: 999rpx; color: #fffefa; font-size: 17rpx; line-height: 1.25; }
.water-tag.gold { background: #af8439; }
.water-tag.silver { background: #70808a; }
.vote-tabs { margin: 6rpx 0 14rpx; white-space: nowrap; }
.vote-tab { display: inline-block; margin-right: 9rpx; padding: 10rpx 14rpx; border: 1rpx solid #d9dad2; border-radius: 999rpx; color: #71776e; background: #fffefa; font-size: 22rpx; }
.vote-tab.active { border-color: #52695e; color: #30493d; background: #edf3ed; font-weight: 600; }
.vote-history-rows { border-top: 1rpx solid #e8e8e1; }
.empty-votes { padding: 15rpx 0 4rpx; color: #7c8179; font-size: 24rpx; }
.info-mask { position: fixed; z-index: 99; inset: 0; display: flex; align-items: flex-end; padding: 20rpx; background: rgba(26, 32, 29, .46); }
.seat-info { box-sizing: border-box; width: 100%; padding: 32rpx 28rpx 28rpx; border-radius: 22rpx; background: #fffefa; box-shadow: 0 -10rpx 35rpx rgba(0, 0, 0, .15); }
.seat-info .title { margin-bottom: 20rpx; }
.info-row { display: flex; justify-content: space-between; gap: 28rpx; padding: 15rpx 0; border-top: 1rpx solid #e7e7e0; color: #555d55; }
.info-row text:last-child { color: #27332d; text-align: right; }
.seat-info button { width: 100%; margin-top: 24rpx; }
