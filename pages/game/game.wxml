<view class="page game-page {{game.phase === 'night' ? 'is-night' : 'is-day'}}" wx:if="{{game}}">
  <view class="game-topbar">
    <view class="phase-title"><view class="eyebrow">{{game.phase === 'night' ? '夜间主持' : '白天主持'}}</view><view class="game-title"><text class="day-affix">第</text><text class="day-number">{{game.day}}</text><text class="day-affix">{{game.phase === 'night' ? '夜' : '天'}}</text></view></view>
    <view class="board-stamp board-link" bindtap="openBoardDetail"><text>{{game.boardName}}</text><text class="board-link-arrow">›</text></view>
    <view wx:if="{{canGoBack}}" id="hold-back" class="back-control {{confirmationPulse === 'back' ? 'armed' : ''}}" data-hold-key="back" bindtouchstart="startHold" bindtouchend="endHold" bindtouchcancel="cancelHold" bindanimationend="completeHold"><text>←</text></view>
  </view>

  <block wx:if="{{pendingSheriffTransfer}}">
    <view class="settlement-panel sheriff-transfer-panel"><view class="eyebrow">警徽结算</view><view class="skill-question">{{pendingSheriffTransfer.number}}号警长，请决定警徽去向。</view><view class="transfer-copy">警长只能撕毁警徽，或将警徽移交给一名可接警徽的存活玩家。</view><view wx:if="{{sheriffTransferTargets.length}}" class="transfer-actions"><picker range="{{sheriffTransferTargetLabels}}" value="{{selectedSheriffTransferIndex}}" bindchange="selectSheriffTransferTarget"><view class="picker">移交给：{{sheriffTransferTargetLabels[selectedSheriffTransferIndex]}}</view></picker><view class="button-row"><button bindtap="tearSheriffBadge">撕毁警徽</button><button class="primary" bindtap="transferSheriffBadge">确认移交</button></view></view><button wx:else class="settlement-action" bindtap="tearSheriffBadge">没有可移交玩家，撕毁警徽</button></view>
  </block>
  <block wx:elif="{{pendingSkill}}">
    <view class="settlement-panel"><view class="eyebrow">出局结算</view><view class="skill-question">{{pendingSkill.number}}号玩家，请问是否发动技能？</view><view wx:if="{{choosingSkillTarget}}" class="field"><view class="label">请选择技能目标</view><picker range="{{skillTargetLabels}}" value="{{selectedSkillTargetIndex}}" bindchange="selectSkillTarget"><view class="picker">{{skillTargetLabels[selectedSkillTargetIndex]}}</view></picker><button class="primary settlement-action" bindtap="confirmDeathSkillTarget">确认发动技能</button></view><view wx:elif="{{pendingSkill.canUse}}" class="button-row"><button bindtap="declineDeathSkill">不发动</button><button class="primary" bindtap="requestDeathSkill">发动技能</button></view><view wx:else class="unavailable-skill"><view>此身份当前无法发动技能</view><button disabled>无法发动技能</button><button bindtap="declineDeathSkill">确认继续</button></view></view>
  </block>
  <block wx:elif="{{pendingLastWord}}">
    <view class="settlement-panel"><view class="eyebrow">遗言</view><view class="skill-question">请{{pendingLastWord.number}}号玩家发表遗言。</view><button class="primary settlement-action" bindtap="nextLastWord">遗言结束，继续流程</button></view>
  </block>
  <block wx:else>
    <view wx:if="{{game.status === 'ended'}}" class="result-panel"><view class="eyebrow">本局结束</view><view class="title">{{game.winner}}获胜</view><view class="muted">胜负条件已经满足。</view></view>

    <block wx:elif="{{game.phase === 'night'}}">
      <view wx:if="{{identityAssignmentPending}}" class="identity-panel">
        <view class="identity-heading"><view><view class="eyebrow">第一夜 · 身份确认</view><view class="subtitle">{{identityRole.nextActionName ? '确认后继续：' + identityRole.nextActionName : '确认无主动夜间技能的身份'}}</view></view><text>{{identityProgressText}}</text></view>
        <view class="identity-progress"><view class="identity-progress-fill" style="width: {{identityProgressPercent}}%;"></view></view>
        <block wx:if="{{identityRole}}">
          <view class="identity-script"><view class="identity-role">{{identityRole.name}}</view><view class="identity-prompt">{{identityRole.name}}请睁眼。</view><view class="identity-private">以下内容仅供法官操作，不要念出号码：请选择 {{identityRole.required}} 名{{identityRole.name}}。</view></view>
          <view class="identity-number-grid"><view wx:for="{{identitySeatCards}}" wx:key="number" class="identity-seat tap-surface {{item.selected ? 'selected' : ''}} {{item.assigned ? 'assigned' : ''}}" data-number="{{item.number}}" bindtap="toggleIdentitySeat"><view class="identity-seat-number">{{item.number}}号</view><view class="identity-seat-state">{{item.selected ? '本轮已选' : (item.assigned ? item.roleName : '待确认')}}</view></view></view>
          <view class="identity-selection">本轮已选 {{identityRole.selectedCount}} / {{identityRole.required}} 人</view>
          <button class="primary full-action" disabled="{{!identityCanConfirm}}" bindtap="confirmIdentityRole">确认{{identityRole.name}}身份</button>
          <view class="identity-tip">确认当前身份后，有夜间技能就立即操作；没有夜间技能则直接进入下一张身份牌。最后一种剩余身份由系统自动补齐。</view>
        </block>
      </view>
      <block wx:else>
      <view class="night-console">
        <view class="console-heading"><view><view class="eyebrow">夜间流程</view><view class="subtitle">主持词与行动记录</view></view><view class="console-note">{{nightFlowProgressText}}</view></view>
        <view class="host-sheet">
          <view class="host-line main-line"><text class="line-number">01</text><text>天黑请闭眼。</text></view>
          <view wx:for="{{nightActionCards}}" wx:for-item="action" wx:key="id" class="script-step {{index === nightActionCards.length - 1 ? 'last-step' : ''}}">
            <view class="host-line"><text class="line-number">{{action.order}}</text><text>{{action.name}}。</text></view>
            <view class="night-action-prompt">{{action.prompt}}</view>
            <view wx:if="{{action.id === 'wolves'}}" class="script-note">狼队：{{wolfMembers || '当前无共同睁眼的狼人'}}</view>
            <view wx:if="{{!action.enabled}}" class="night-action-disabled">{{action.inactiveReason}}</view>
            <block wx:else>
              <view wx:if="{{action.kind === 'target'}}" class="inline-entry"><picker wx:if="{{action.targetLabels.length}}" range="{{action.targetLabels}}" value="{{action.targetIndex}}" data-action-id="{{action.id}}" bindchange="selectNightActionTarget"><view class="inline-picker">{{action.selectedTarget ? action.selectedTarget + '号' : '选择目标'}}</view></picker><view wx:else class="muted">当前没有合法目标</view><button wx:if="{{action.optional && action.selectedTarget}}" class="night-skip" data-action-id="{{action.id}}" bindtap="clearNightAction">本夜不发动</button><text wx:if="{{action.result}}" class="inspection-inline">结果：{{action.result}}</text></view>
              <view wx:elif="{{action.kind === 'multiTarget'}}" class="night-target-grid"><view wx:for="{{action.targetSeats}}" wx:for-item="target" wx:key="number" class="night-target {{target.selected ? 'selected' : ''}}" data-action-id="{{action.id}}" data-number="{{target.number}}" bindtap="toggleNightActionTarget">{{target.number}}号</view><view class="night-target-count">已选 {{action.targets.length}} / {{action.targetCount}}</view><button wx:if="{{action.optional && action.targets.length}}" class="night-skip" data-action-id="{{action.id}}" bindtap="clearNightAction">本夜不发动</button></view>
              <view wx:elif="{{action.kind === 'skillTarget'}}" class="night-choice-entry"><picker range="{{action.choiceOptions}}" value="{{action.choiceIndex}}" data-action-id="{{action.id}}" bindchange="selectNightActionChoice"><view class="inline-picker">{{action.choiceLabel || '选择技能'}}</view></picker><picker range="{{action.targetLabels}}" value="{{action.targetIndex}}" data-action-id="{{action.id}}" bindchange="selectNightActionTarget"><view class="inline-picker">{{action.selectedTarget ? action.selectedTarget + '号' : '选择幸运儿'}}</view></picker><button wx:if="{{action.optional && (action.choice || action.selectedTarget)}}" class="night-skip" data-action-id="{{action.id}}" bindtap="clearNightAction">本夜不发动</button></view>
              <view wx:elif="{{action.kind === 'witch'}}" class="night-choice-entry"><picker range="{{action.witchChoices}}" value="{{action.witchChoiceIndex}}" data-action-id="{{action.id}}" bindchange="selectNightActionChoice"><view class="inline-picker">{{action.choice === 'save' ? '使用解药' : (action.choice === 'poison' ? '使用毒药' : '不用药')}}</view></picker><picker wx:if="{{action.choice === 'poison'}}" range="{{action.targetLabels}}" value="{{action.targetIndex}}" data-action-id="{{action.id}}" bindchange="selectNightActionTarget"><view class="inline-picker">{{action.selectedTarget ? '毒 ' + action.selectedTarget + '号' : '选择毒药目标'}}</view></picker><view wx:if="{{action.id === 'witch'}}" class="resource-line">解药：{{game.resources.antidote ? '可用' : '已用'}}　毒药：{{game.resources.poison ? '可用' : '已用'}}</view></view>
              <view wx:else class="night-information">{{action.information || '本段只需向对应身份展示信息。'}}</view>
            </block>
            <view class="host-closure">行动结束，请闭眼。</view>
          </view>
        </view>
      </view>
      <button wx:if="{{guidedNightActionPending}}" class="primary finish-button" bindtap="completeGuidedNightAction">完成当前行动，进入下一项</button>
      <button wx:else class="primary finish-button" bindtap="finishNight">夜间行动结束，天亮</button>
      </block>
    </block>

    <block wx:else>
      <view class="day-console">
        <view class="day-head"><view><view class="eyebrow">白天流程 · {{dayStageLabel}}</view><view class="subtitle">天亮了</view><view class="narration">按当前阶段继续主持。</view></view><button wx:if="{{selfExposeCandidates.length}}" class="self-expose" bindtap="triggerSelfExpose">狼人自曝</button></view>
        <view wx:if="{{dayMessage}}" class="notice-bar">{{dayMessage}}</view>
        <button wx:if="{{pendingWolfKingClaw}}" class="claw-button" bindtap="triggerWolfKingClaw">处理狼王爪击</button>

        <view wx:if="{{dayState.stage === 'sheriffSignup'}}" class="stage-panel"><view class="stage-kicker">01</view><view class="subtitle">上警</view><view class="stage-copy">点击举手上警的玩家；再次点击可退水。</view><view class="seat-pills"><view wx:for="{{sheriffSignupSeats}}" wx:key="number" class="seat-pill tap-surface {{item.selected ? 'chosen' : ''}}" data-number="{{item.number}}" bindtap="toggleSheriffCandidate">{{item.number}}号</view></view><view class="button-row"><button class="secondary" bindtap="noSheriff">无人上警</button><button class="primary" bindtap="beginSheriffSpeech">确认名单</button></view></view>
        <view wx:elif="{{dayState.stage === 'sheriffSpeech'}}" class="stage-panel"><view class="stage-kicker">02</view><view class="subtitle">{{dayState.sheriffPk ? '警长PK发言' : '警上发言'}}</view><view class="stage-copy">长按退水。退水玩家不可参与本轮投票。</view><view class="seat-pills"><view wx:for="{{sheriffWithdrawalSeats}}" wx:key="number" class="seat-pill chosen withdraw-pill {{confirmationPulse === 'withdraw-' + item.number ? 'armed' : ''}}" data-number="{{item.number}}" data-hold-key="withdraw-{{item.number}}" bindtouchstart="startHold" bindtouchend="endHold" bindtouchcancel="cancelHold" bindanimationend="completeHold"><text>{{item.number}}号</text></view></view><button class="primary full-action" bindtap="beginSheriffVote">{{dayState.sheriffPk ? 'PK发言结束' : '进入警长投票'}}</button></view>
        <view wx:elif="{{dayState.stage === 'sheriffResumeWithdraw'}}" class="stage-panel"><view class="stage-kicker">退水</view><view class="subtitle">记录退水玩家</view><view class="stage-copy">长按号码退水。首日警上自曝后，第二天直接退水并投警长。</view><view class="seat-pills"><view wx:for="{{sheriffWithdrawalSeats}}" wx:key="number" class="seat-pill chosen withdraw-pill {{confirmationPulse === 'withdraw-' + item.number ? 'armed' : ''}}" data-number="{{item.number}}" data-hold-key="withdraw-{{item.number}}" bindtouchstart="startHold" bindtouchend="endHold" bindtouchcancel="cancelHold" bindanimationend="completeHold"><text>{{item.number}}号</text></view></view><button class="primary full-action" bindtap="beginSheriffVote">退水结束，进入警长投票</button></view>
        <view wx:elif="{{dayState.stage === 'sheriffVote'}}" class="stage-panel vote-stage"><view class="stage-kicker">03</view><view class="subtitle">警长投票</view><view class="stage-copy">可多选警下投票者，再一次记录同一投向。候选人：{{sheriffCandidateText}}</view><view class="voter-grid"><view wx:for="{{dayVoters}}" wx:key="number" class="voter tap-surface {{item.selected ? 'selected' : ''}} {{item.number === sheriffSeat ? 'sheriff-star' : ''}}" data-index="{{index}}" bindtap="selectDayVoter"><text wx:if="{{item.number === sheriffSeat}}" class="sheriff-watermark">⬡</text><text class="voter-number">{{item.number}}号</text></view></view><picker range="{{voteTargetLabels}}" value="{{selectedVoteTargetIndex}}" bindchange="selectVoteTarget"><view class="picker">投给：{{voteTargetLabels[selectedVoteTargetIndex]}}</view></picker><view class="button-row"><button class="secondary" bindtap="recordVote">记录所选投票者</button><button class="primary" bindtap="resolveSheriffVote">统计警长票</button></view><view class="vote-ledger"><view wx:for="{{voteRecords}}" wx:key="target" class="vote-row">{{item.target}}：{{item.voters}}</view><view wx:for="{{voteTally}}" wx:key="number" class="vote-row tally-row">{{item.number}}号：{{item.value}}票</view></view></view>
        <view wx:elif="{{dayState.stage === 'sheriffTie'}}" class="stage-panel"><view class="stage-kicker">平票</view><view class="subtitle">警长投票平票</view><view class="stage-copy">{{dayMessage}}</view><view class="button-row"><button bindtap="restartSheriffVote">平票玩家发言并重投</button><button bindtap="noSheriff">警徽流失</button></view></view>
        <view wx:elif="{{dayState.stage === 'sheriffOrder'}}" class="stage-panel"><view class="stage-kicker">04</view><view class="subtitle">警长决定发言顺序</view><view class="stage-copy">{{sheriffSeat}}号警长请决定从警左还是警右开始发言。</view><view class="button-row"><button class="primary" data-direction="clockwise" bindtap="setSpeakingOrder">顺序发言</button><button data-direction="counterclockwise" bindtap="setSpeakingOrder">逆序发言</button></view></view>
        <view wx:elif="{{dayState.stage === 'alchemistDiscussion'}}" class="stage-panel"><view class="stage-kicker">炼金魔女</view><view class="subtitle">先进行放逐发言</view><view class="stage-copy">法老之蛇尚未使用，本日暂不公布昨夜出局信息。请先完成全场放逐发言。</view><button wx:if="{{knightAvailable}}" class="secondary full-action" bindtap="triggerKnightDuel">骑士翻牌决斗</button><button class="primary full-action" bindtap="finishAlchemistDiscussion">发言结束，询问法老之蛇</button></view>
        <view wx:elif="{{dayState.stage === 'alchemistSnake'}}" class="stage-panel"><view class="stage-kicker">法老之蛇</view><view class="subtitle">{{alchemistWolfTarget}}号被狼队选中</view><view class="stage-copy">此信息仅供法官向炼金魔女展示。觉醒爪击和梦亡不能被法老之蛇救回。</view><view class="button-row"><button data-use="no" bindtap="resolveAlchemistSnake">不使用</button><button class="primary" data-use="yes" bindtap="resolveAlchemistSnake">使用法老之蛇</button></view></view>
        <view wx:elif="{{dayState.stage === 'announceNight'}}" class="stage-panel"><view class="stage-kicker">公布</view><view class="subtitle">昨夜信息</view><view class="night-result-copy">{{nightDeathText}}</view><view wx:if="{{dayMessage}}" class="stage-copy">{{dayMessage}}</view><button class="primary full-action" bindtap="announceNightDeaths">已公布，进入出局结算</button></view>
        <view wx:elif="{{dayState.stage === 'selfExposeNight'}}" class="stage-panel"><view class="stage-kicker">自曝结算</view><view class="subtitle">白天流程结束</view><view class="stage-copy">请宣布：当前白天流程结束，天黑请闭眼。</view><button class="primary full-action" bindtap="enterSelfExposeNight">进入黑夜</button></view>
        <view wx:elif="{{dayState.stage === 'discussion'}}" class="stage-panel"><view class="stage-kicker">05</view><view class="subtitle">白天发言</view><view class="stage-copy">{{sheriffSeat ? sheriffSeat + '号警长已确定发言方向。' : '无警长，请由法官决定发言顺序。'}}</view><button wx:if="{{knightAvailable}}" class="secondary full-action" bindtap="triggerKnightDuel">骑士翻牌决斗</button><button class="primary full-action" bindtap="beginExileVote">发言结束，开始放逐投票</button></view>
        <view wx:elif="{{dayState.stage === 'exileVote'}}" class="stage-panel vote-stage"><view class="stage-kicker">06</view><view class="subtitle">放逐投票</view><view class="mode-switch segmented-control"><view class="mode-item segmented-item tap-surface {{dayState.exileMode === 'individual' ? 'active' : ''}}" data-mode="individual" bindtap="setExileMode">逐票记录</view><view class="mode-item segmented-item tap-surface {{dayState.exileMode === 'simple' ? 'active' : ''}}" data-mode="simple" bindtap="setExileMode">简易计票</view></view><block wx:if="{{dayState.exileMode === 'individual'}}"><view class="stage-copy">六角星代表警长票，计为 {{sheriffWeight}} 票。</view><view class="voter-grid"><view wx:for="{{dayVoters}}" wx:key="number" class="voter tap-surface {{item.selected ? 'selected' : ''}} {{item.number === sheriffSeat ? 'sheriff-star' : ''}}" data-index="{{index}}" bindtap="selectDayVoter"><text wx:if="{{item.number === sheriffSeat}}" class="sheriff-watermark">⬡</text><text class="voter-number">{{item.number}}号</text></view></view><picker range="{{voteTargetLabels}}" value="{{selectedVoteTargetIndex}}" bindchange="selectVoteTarget"><view class="picker">投给：{{voteTargetLabels[selectedVoteTargetIndex]}}</view></picker><button class="secondary record-button" bindtap="recordVote">记录所选投票者</button><view class="vote-ledger"><view wx:for="{{voteRecords}}" wx:key="target" class="vote-row">{{item.target}}：{{item.voters}}</view></view></block><block wx:else><picker range="{{voteTargetLabels}}" value="{{selectedVoteTargetIndex}}" bindchange="selectVoteTarget"><view class="picker">统计 {{voteTargetLabels[selectedVoteTargetIndex]}} 的票数</view></picker><input class="vote-input" type="digit" value="{{simpleVoteCount}}" placeholder="输入票数（可填 1.5）" bindinput="inputSimpleVoteCount"/><button class="secondary record-button" bindtap="recordSimpleVote">记录票数</button></block><view class="tally-title">当前统计</view><view class="vote-ledger"><view wx:for="{{voteTally}}" wx:key="number" class="vote-row tally-row">{{item.number}}号：{{item.value}}票</view></view><button class="primary full-action" bindtap="resolveExileVote">结束投票并结算放逐</button></view>
        <view wx:elif="{{dayState.stage === 'exileTie'}}" class="stage-panel"><view class="stage-kicker">平票</view><view class="subtitle">放逐投票平票</view><view class="stage-copy">{{dayMessage}}</view><view class="button-row"><button bindtap="beginExileVote">平票玩家发言并重投</button><button bindtap="recordNoExile">记录无人出局</button></view></view>
        <view wx:elif="{{dayState.stage === 'orderPrinceDecision'}}" class="stage-panel"><view class="stage-kicker">定序王子</view><view class="subtitle">是否逆转本次投票</view><view class="stage-copy">本日第一次放逐投票已经结束。定序王子可以翻牌，撤销本次结果并获得一次额外发言，然后全场重新投票。</view><view class="button-row"><button data-activate="no" bindtap="decideOrderPrince">不发动</button><button class="primary" data-activate="yes" bindtap="decideOrderPrince">翻牌发动</button></view></view>
        <view wx:elif="{{dayState.stage === 'orderPrinceSpeech'}}" class="stage-panel"><view class="stage-kicker">身份已公开</view><view class="subtitle">定序王子额外发言</view><view class="stage-copy">此段发言期间狼人不能自曝。发言结束后重新进行本日放逐投票。</view><button class="primary full-action" bindtap="finishOrderPrinceSpeech">发言结束，重新投票</button></view>
        <view wx:elif="{{dayState.stage === 'exileDone'}}" class="stage-panel"><view class="stage-kicker">结算完成</view><view class="subtitle">白天结束</view><button class="primary full-action" bindtap="enterNight">进入黑夜</button></view>
      </view>
    </block>
  </block>

  <view class="game-reference">
    <view class="log-panel"><view class="panel-heading"><view class="subtitle">对局记录</view><text>仅法官可见</text></view><view wx:for="{{game.logs}}" wx:key="time" class="log-item">{{item.text}}</view></view>
    <view class="seat-panel"><view class="panel-heading"><view class="subtitle">座位状态</view><text>{{aliveSeats.length}} 人存活</text></view><view class="seat-grid"><view wx:for="{{seatCards}}" wx:key="number" class="seat-tile tap-surface {{item.alive ? '' : 'dead'}}" data-number="{{item.number}}" bindtap="openSeatInfo"><view class="seat-tile-top"><text class="seat-tile-number">{{item.number}}<text>号</text></text><text class="seat-state">{{item.alive ? (item.foolRevealed ? '翻牌' : '存活') : '出局'}}</text></view><view class="seat-role">{{item.roleName}}</view><view class="seat-marks"><text wx:if="{{item.marks.goldWater}}" class="water-tag gold">金水</text><text wx:if="{{item.marks.silverWater}}" class="water-tag silver">银水</text></view></view></view></view>
    <view class="vote-history"><view class="panel-heading"><view class="subtitle">投票状态</view></view><scroll-view scroll-x class="vote-tabs"><view wx:for="{{voteHistory}}" wx:key="id" class="vote-tab tap-surface {{selectedVoteHistoryIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectVoteHistory">{{item.label}}</view></scroll-view><view wx:if="{{selectedVoteRound}}" class="vote-history-rows"><view wx:for="{{selectedVoteRows}}" wx:key="target" class="vote-row">{{item.target}}：{{item.voters}}</view><view wx:for="{{selectedVoteRound.tally}}" wx:key="number" class="vote-row tally-row">{{item.number}}号：{{item.value}}票</view></view><view wx:else class="empty-votes">暂未完成任何一轮投票。</view></view>
  </view>

  <view wx:if="{{seatInfo}}" class="info-mask" bindtap="closeSeatInfo"><view class="seat-info" catchtap=""><view class="eyebrow">座位详情</view><view class="title">{{seatInfo.number}}号牌</view><view class="info-row"><text>身份</text><text>{{seatInfo.roleName}}</text></view><view class="info-row"><text>状态</text><text>{{seatInfo.alive ? '存活' : '出局'}}</text></view><view wx:if="{{!seatInfo.alive}}" class="info-row"><text>出局原因</text><text>{{seatInfo.deathCause}}</text></view><button bindtap="closeSeatInfo">关闭</button></view></view>
</view>
