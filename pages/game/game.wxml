<view class="page game-page {{game.phase === 'night' ? 'is-night' : 'is-day'}}" wx:if="{{game}}">
  <view class="game-topbar">
    <view class="phase-title"><view class="eyebrow">{{game.phase === 'night' ? '夜间主持' : '白天主持'}}</view><view class="game-title"><text class="day-affix">第</text><text class="day-number">{{game.day}}</text><text class="day-affix">{{game.phase === 'night' ? '夜' : '天'}}</text></view></view>
    <view class="board-stamp board-link" bindtap="openBoardDetail"><text>{{game.boardName}}</text><text class="board-link-arrow">›</text></view>
    <view wx:if="{{canGoBack}}" id="hold-back" class="back-control {{confirmationPulse === 'back' ? 'armed' : ''}}" data-hold-key="back" bindtouchstart="startHold" bindtouchend="endHold" bindtouchcancel="cancelHold" bindanimationend="completeHold"><text>←</text></view>
  </view>

  <block wx:if="{{pendingSkill}}">
    <view class="settlement-panel"><view class="eyebrow">出局结算</view><view class="skill-question">{{pendingSkill.number}}号玩家，请问是否发动技能？</view><view wx:if="{{choosingSkillTarget}}" class="field"><view class="label">请选择技能目标</view><picker range="{{skillTargetLabels}}" value="{{selectedSkillTargetIndex}}" bindchange="selectSkillTarget"><view class="picker">{{skillTargetLabels[selectedSkillTargetIndex]}}</view></picker><button class="primary settlement-action" bindtap="confirmDeathSkillTarget">确认发动技能</button></view><view wx:elif="{{pendingSkill.canUse}}" class="button-row"><button bindtap="declineDeathSkill">不发动</button><button class="primary" bindtap="requestDeathSkill">发动技能</button></view><view wx:else class="unavailable-skill"><view>此身份当前无法发动技能</view><button disabled>无法发动技能</button><button bindtap="declineDeathSkill">确认继续</button></view></view>
  </block>
  <block wx:elif="{{pendingLastWord}}">
    <view class="settlement-panel"><view class="eyebrow">遗言</view><view class="skill-question">请{{pendingLastWord.number}}号玩家发表遗言。</view><button class="primary settlement-action" bindtap="nextLastWord">遗言结束，继续流程</button></view>
  </block>
  <block wx:else>
    <view wx:if="{{game.status === 'ended'}}" class="result-panel"><view class="eyebrow">本局结束</view><view class="title">{{game.winner}}获胜</view><view class="muted">胜负条件已经满足。</view></view>

    <block wx:elif="{{game.phase === 'night'}}">
      <view class="night-console">
        <view class="console-heading"><view><view class="eyebrow">夜间流程</view><view class="subtitle">主持词与行动记录</view></view><view class="console-note">照读即可</view></view>
        <view class="host-sheet">
          <view class="host-line main-line"><text class="line-number">01</text><text>天黑请闭眼。</text></view>
          <block wx:if="{{hasLonelyGirl && game.day === 1}}"><view class="script-step"><view class="host-line"><text class="line-number">02</text><text>孤独少女（{{lonelyGirlNumber}}号）睁眼，请选择你的崇拜对象。</text></view><view wx:if="{{lonelyGirlAlive}}" class="inline-entry"><picker range="{{lonelyGirlTargetLabels}}" value="{{lonelyGirlTargetIndex}}" bindchange="selectLonelyGirlTarget"><view class="inline-picker">{{game.special.lonelyGirlTarget ? game.special.lonelyGirlTarget + '号' : '请选择'}}</view></picker></view><view wx:else class="muted note">孤独少女已出局，流程照走，无需记录。</view><view class="host-closure">孤独少女闭眼。</view></view></block>
          <view class="script-step"><view class="host-line"><text class="line-number">{{hasLonelyGirl ? '03' : '02'}}</text><text>狼人请睁眼，确认同伴，狼人商量战术。</text></view><view class="script-note">狼队：{{wolfMembers}}</view><view wx:if="{{wolfAlive}}" class="inline-entry"><text>选择刀人目标</text><picker range="{{aliveLabels}}" value="{{wolfTargetIndex}}" data-field="wolfTarget" bindchange="updateNightTarget"><view class="inline-picker">{{game.night.wolfTarget ? game.night.wolfTarget + '号' : '请选择'}}</view></picker></view><view wx:else class="muted note">狼人阵营已全部出局，仍正常念完本段旁白。</view><view class="host-closure">狼人闭眼。</view></view>
          <block wx:if="{{hasGuard}}"><view class="script-step"><view class="host-line"><text class="line-number">{{hasLonelyGirl ? '04' : '03'}}</text><text>守卫（{{guardNumber}}号）睁眼，请选择今晚要守护的玩家。</text></view><view wx:if="{{guardAlive}}" class="inline-entry"><picker range="{{aliveLabels}}" value="{{guardTargetIndex}}" data-field="guardTarget" bindchange="updateNightTarget"><view class="inline-picker">{{game.night.guardTarget ? game.night.guardTarget + '号' : '请选择'}}</view></picker><text class="muted">不能连续两晚守同一人</text></view><view wx:else class="muted note">守卫已出局，流程照走，无需记录。</view><view class="host-closure">守卫闭眼。</view></view></block>
          <view class="script-step"><view class="host-line"><text class="line-number">{{hasLonelyGirl ? (hasGuard ? '05' : '04') : (hasGuard ? '04' : '03')}}</text><text>预言家（{{seerNumber}}号）睁眼，预言家验人。</text></view><view wx:if="{{seerAlive}}" class="inline-entry"><text>查验对象</text><picker range="{{aliveLabels}}" value="{{seerTargetIndex}}" data-field="seerTarget" bindchange="updateNightTarget"><view class="inline-picker">{{game.night.seerTarget ? game.night.seerTarget + '号' : '请选择'}}</view></picker><text wx:if="{{inspection}}" class="inspection-inline">身份：{{inspection}}</text></view><view wx:else class="muted note">预言家已出局，流程照走，无需记录。</view><view class="host-closure">预言家闭眼。</view></view>
          <view class="script-step last-step"><view class="host-line"><text class="line-number">{{hasLonelyGirl ? (hasGuard ? '06' : '05') : (hasGuard ? '05' : '04')}}</text><text>女巫（{{witchNumber}}号）睁眼，{{game.resources.antidote ? (game.night.wolfTarget ? '今晚' + game.night.wolfTarget + '号死了。' : '今晚无人倒牌。') : '解药已用，不公布刀口。'}}救人给手势，毒人给数字，摆手不作为。</text></view><view wx:if="{{witchAlive}}" class="inline-entry witch-entry"><picker range="{{witchActions}}" value="{{witchActionIndex}}" bindchange="selectWitchAction"><view class="inline-picker">{{witchActions[witchActionIndex]}}</view></picker><picker wx:if="{{witchActionIndex === 2}}" range="{{aliveLabels}}" value="{{witchTargetIndex}}" data-field="witchTarget" bindchange="updateNightTarget"><view class="inline-picker">毒 {{game.night.witchTarget ? game.night.witchTarget + '号' : '请选择'}}</view></picker><view class="resource-line">解药：{{game.resources.antidote ? '可用' : '已用'}}　毒药：{{game.resources.poison ? '可用' : '已用'}}</view></view><view wx:else class="muted note">女巫已出局，流程照走，无需记录。</view><view class="host-closure">女巫闭眼。</view></view>
        </view>
      </view>
      <button class="primary finish-button" bindtap="finishNight">夜间行动结束，天亮</button>
    </block>

    <block wx:else>
      <view class="day-console">
        <view class="day-head"><view><view class="eyebrow">白天流程 · {{dayStageLabel}}</view><view class="subtitle">天亮了</view><view class="narration">按当前阶段继续主持。</view></view><button wx:if="{{selfExposeCandidates.length}}" class="self-expose" bindtap="triggerSelfExpose">狼人自曝</button></view>
        <view wx:if="{{dayMessage}}" class="notice-bar">{{dayMessage}}</view>
        <button wx:if="{{pendingWolfKingClaw}}" class="claw-button" bindtap="triggerWolfKingClaw">处理狼王爪击</button>

        <view wx:if="{{dayState.stage === 'sheriffSignup'}}" class="stage-panel"><view class="stage-kicker">01</view><view class="subtitle">上警</view><view class="stage-copy">点击举手上警的玩家；再次点击可退水。</view><view class="seat-pills"><view wx:for="{{sheriffSignupSeats}}" wx:key="number" class="seat-pill {{item.selected ? 'chosen' : ''}}" data-number="{{item.number}}" bindtap="toggleSheriffCandidate">{{item.number}}号</view></view><view class="button-row"><button bindtap="noSheriff">无人上警</button><button class="primary" bindtap="beginSheriffSpeech">确认名单</button></view></view>
        <view wx:elif="{{dayState.stage === 'sheriffSpeech'}}" class="stage-panel"><view class="stage-kicker">02</view><view class="subtitle">{{dayState.sheriffPk ? '警长PK发言' : '警上发言'}}</view><view class="stage-copy">长按退水。退水玩家不可参与本轮投票。</view><view class="seat-pills"><view wx:for="{{sheriffWithdrawalSeats}}" wx:key="number" class="seat-pill chosen withdraw-pill {{confirmationPulse === 'withdraw-' + item.number ? 'armed' : ''}}" data-number="{{item.number}}" data-hold-key="withdraw-{{item.number}}" bindtouchstart="startHold" bindtouchend="endHold" bindtouchcancel="cancelHold" bindanimationend="completeHold"><text>{{item.number}}号</text></view></view><button class="primary full-action" bindtap="beginSheriffVote">{{dayState.sheriffPk ? 'PK发言结束' : '进入警长投票'}}</button></view>
        <view wx:elif="{{dayState.stage === 'sheriffResumeWithdraw'}}" class="stage-panel"><view class="stage-kicker">退水</view><view class="subtitle">记录退水玩家</view><view class="stage-copy">长按号码退水。首日警上自曝后，第二天直接退水并投警长。</view><view class="seat-pills"><view wx:for="{{sheriffWithdrawalSeats}}" wx:key="number" class="seat-pill chosen withdraw-pill {{confirmationPulse === 'withdraw-' + item.number ? 'armed' : ''}}" data-number="{{item.number}}" data-hold-key="withdraw-{{item.number}}" bindtouchstart="startHold" bindtouchend="endHold" bindtouchcancel="cancelHold" bindanimationend="completeHold"><text>{{item.number}}号</text></view></view><button class="primary full-action" bindtap="beginSheriffVote">退水结束，进入警长投票</button></view>
        <view wx:elif="{{dayState.stage === 'sheriffVote'}}" class="stage-panel vote-stage"><view class="stage-kicker">03</view><view class="subtitle">警长投票</view><view class="stage-copy">可多选警下投票者，再一次记录同一投向。候选人：{{sheriffCandidateText}}</view><view class="voter-grid"><view wx:for="{{dayVoters}}" wx:key="number" class="voter {{item.selected ? 'selected' : ''}} {{item.number === sheriffSeat ? 'sheriff-star' : ''}}" data-index="{{index}}" bindtap="selectDayVoter"><text wx:if="{{item.number === sheriffSeat}}" class="sheriff-watermark">⬡</text><text class="voter-number">{{item.number}}号</text></view></view><picker range="{{voteTargetLabels}}" value="{{selectedVoteTargetIndex}}" bindchange="selectVoteTarget"><view class="picker">投给：{{voteTargetLabels[selectedVoteTargetIndex]}}</view></picker><view class="button-row"><button bindtap="recordVote">记录所选投票者</button><button class="primary" bindtap="resolveSheriffVote">统计警长票</button></view><view class="vote-ledger"><view wx:for="{{voteRecords}}" wx:key="target" class="vote-row">{{item.target}}：{{item.voters}}</view><view wx:for="{{voteTally}}" wx:key="number" class="vote-row tally-row">{{item.number}}号：{{item.value}}票</view></view></view>
        <view wx:elif="{{dayState.stage === 'sheriffTie'}}" class="stage-panel"><view class="stage-kicker">平票</view><view class="subtitle">警长投票平票</view><view class="stage-copy">{{dayMessage}}</view><view class="button-row"><button bindtap="restartSheriffVote">平票玩家发言并重投</button><button bindtap="noSheriff">警徽流失</button></view></view>
        <view wx:elif="{{dayState.stage === 'sheriffOrder'}}" class="stage-panel"><view class="stage-kicker">04</view><view class="subtitle">警长决定发言顺序</view><view class="stage-copy">{{sheriffSeat}}号警长请决定从警左还是警右开始发言。</view><view class="button-row"><button class="primary" data-direction="clockwise" bindtap="setSpeakingOrder">顺序发言</button><button data-direction="counterclockwise" bindtap="setSpeakingOrder">逆序发言</button></view></view>
        <view wx:elif="{{dayState.stage === 'announceNight'}}" class="stage-panel"><view class="stage-kicker">公布</view><view class="subtitle">昨夜信息</view><view class="night-result-copy">{{nightDeathText}}</view><view wx:if="{{dayMessage}}" class="stage-copy">{{dayMessage}}</view><button class="primary full-action" bindtap="announceNightDeaths">已公布，进入出局结算</button></view>
        <view wx:elif="{{dayState.stage === 'selfExposeNight'}}" class="stage-panel"><view class="stage-kicker">自曝结算</view><view class="subtitle">白天流程结束</view><view class="stage-copy">请宣布：当前白天流程结束，天黑请闭眼。</view><button class="primary full-action" bindtap="enterSelfExposeNight">进入黑夜</button></view>
        <view wx:elif="{{dayState.stage === 'discussion'}}" class="stage-panel"><view class="stage-kicker">05</view><view class="subtitle">白天发言</view><view class="stage-copy">{{sheriffSeat ? sheriffSeat + '号警长已确定发言方向。' : '无警长，请由法官决定发言顺序。'}}</view><button class="primary full-action" bindtap="beginExileVote">发言结束，开始放逐投票</button></view>
        <view wx:elif="{{dayState.stage === 'exileVote'}}" class="stage-panel vote-stage"><view class="stage-kicker">06</view><view class="subtitle">放逐投票</view><view class="mode-switch"><view class="mode-item {{dayState.exileMode === 'individual' ? 'active' : ''}}" data-mode="individual" bindtap="setExileMode">逐票记录</view><view class="mode-item {{dayState.exileMode === 'simple' ? 'active' : ''}}" data-mode="simple" bindtap="setExileMode">简易计票</view></view><block wx:if="{{dayState.exileMode === 'individual'}}"><view class="stage-copy">六角星代表警长票，计为 {{sheriffWeight}} 票。</view><view class="voter-grid"><view wx:for="{{dayVoters}}" wx:key="number" class="voter {{item.selected ? 'selected' : ''}} {{item.number === sheriffSeat ? 'sheriff-star' : ''}}" data-index="{{index}}" bindtap="selectDayVoter"><text wx:if="{{item.number === sheriffSeat}}" class="sheriff-watermark">⬡</text><text class="voter-number">{{item.number}}号</text></view></view><picker range="{{voteTargetLabels}}" value="{{selectedVoteTargetIndex}}" bindchange="selectVoteTarget"><view class="picker">投给：{{voteTargetLabels[selectedVoteTargetIndex]}}</view></picker><button class="record-button" bindtap="recordVote">记录所选投票者</button><view class="vote-ledger"><view wx:for="{{voteRecords}}" wx:key="target" class="vote-row">{{item.target}}：{{item.voters}}</view></view></block><block wx:else><picker range="{{voteTargetLabels}}" value="{{selectedVoteTargetIndex}}" bindchange="selectVoteTarget"><view class="picker">统计 {{voteTargetLabels[selectedVoteTargetIndex]}} 的票数</view></picker><input class="vote-input" type="digit" value="{{simpleVoteCount}}" placeholder="输入票数（可填 1.5）" bindinput="inputSimpleVoteCount"/><button class="record-button" bindtap="recordSimpleVote">记录票数</button></block><view class="tally-title">当前统计</view><view class="vote-ledger"><view wx:for="{{voteTally}}" wx:key="number" class="vote-row tally-row">{{item.number}}号：{{item.value}}票</view></view><button class="primary full-action" bindtap="resolveExileVote">结束投票并结算放逐</button></view>
        <view wx:elif="{{dayState.stage === 'exileTie'}}" class="stage-panel"><view class="stage-kicker">平票</view><view class="subtitle">放逐投票平票</view><view class="stage-copy">{{dayMessage}}</view><view class="button-row"><button bindtap="beginExileVote">平票玩家发言并重投</button><button bindtap="recordNoExile">记录无人出局</button></view></view>
        <view wx:elif="{{dayState.stage === 'exileDone'}}" class="stage-panel"><view class="stage-kicker">结算完成</view><view class="subtitle">白天结束</view><button class="primary full-action" bindtap="enterNight">进入黑夜</button></view>
      </view>
    </block>
  </block>

  <view class="game-reference">
    <view class="log-panel"><view class="panel-heading"><view class="subtitle">对局记录</view><text>仅法官可见</text></view><view wx:for="{{game.logs}}" wx:key="time" class="log-item">{{item.text}}</view></view>
    <view class="seat-panel"><view class="panel-heading"><view class="subtitle">座位状态</view><text>{{aliveSeats.length}} 人存活</text></view><view class="seat-grid"><view wx:for="{{seatCards}}" wx:key="number" class="seat-tile {{item.alive ? '' : 'dead'}}" data-number="{{item.number}}" bindtap="openSeatInfo"><view class="seat-tile-top"><text class="seat-tile-number">{{item.number}}<text>号</text></text><text class="seat-state">{{item.alive ? (item.foolRevealed ? '翻牌' : '存活') : '出局'}}</text></view><view class="seat-role">{{item.roleName}}</view><view class="seat-marks"><text wx:if="{{item.marks.goldWater}}" class="water-tag gold">金水</text><text wx:if="{{item.marks.silverWater}}" class="water-tag silver">银水</text></view></view></view></view>
    <view class="vote-history"><view class="panel-heading"><view class="subtitle">投票状态</view></view><scroll-view scroll-x class="vote-tabs"><view wx:for="{{voteHistory}}" wx:key="id" class="vote-tab {{selectedVoteHistoryIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectVoteHistory">{{item.label}}</view></scroll-view><view wx:if="{{selectedVoteRound}}" class="vote-history-rows"><view wx:for="{{selectedVoteRows}}" wx:key="target" class="vote-row">{{item.target}}：{{item.voters}}</view><view wx:for="{{selectedVoteRound.tally}}" wx:key="number" class="vote-row tally-row">{{item.number}}号：{{item.value}}票</view></view><view wx:else class="empty-votes">暂未完成任何一轮投票。</view></view>
  </view>

  <view wx:if="{{seatInfo}}" class="info-mask" bindtap="closeSeatInfo"><view class="seat-info" catchtap=""><view class="eyebrow">座位详情</view><view class="title">{{seatInfo.number}}号牌</view><view class="info-row"><text>身份</text><text>{{seatInfo.roleName}}</text></view><view class="info-row"><text>状态</text><text>{{seatInfo.alive ? '存活' : '出局'}}</text></view><view wx:if="{{!seatInfo.alive}}" class="info-row"><text>出局原因</text><text>{{seatInfo.deathCause}}</text></view><button bindtap="closeSeatInfo">关闭</button></view></view>
</view>
