<view class="page" wx:if="{{game}}">
  <view class="header"><view class="title">第{{game.day}}{{game.phase === 'night' ? '夜' : '天'}}</view><view>{{game.boardName}}</view></view>
  <block wx:if="{{pendingSkill}}">
    <view class="card death-skill"><view class="subtitle">出局技能结算</view><view class="skill-question">{{pendingSkill.number}}号玩家，请问是否发动技能？</view><view wx:if="{{choosingSkillTarget}}" class="field"><view class="label">请选择技能目标</view><picker range="{{skillTargetLabels}}" value="{{selectedSkillTargetIndex}}" bindchange="selectSkillTarget"><view class="picker">{{skillTargetLabels[selectedSkillTargetIndex]}}</view></picker><button class="primary" bindtap="confirmDeathSkillTarget">确认发动技能</button></view><view wx:elif="{{pendingSkill.canUse}}" class="button-row"><button bindtap="declineDeathSkill">不发动</button><button class="primary" bindtap="requestDeathSkill">发动技能</button></view><view wx:else><button disabled>无法发动技能</button><button bindtap="declineDeathSkill">确认继续</button></view></view>
  </block>
  <block wx:elif="{{pendingLastWord}}">
    <view class="card death-skill"><view class="subtitle">遗言</view><view class="skill-question">请{{pendingLastWord.number}}号玩家发表遗言。</view><button class="primary" bindtap="nextLastWord">遗言结束，继续流程</button></view>
  </block>
  <block wx:else>
  <view wx:if="{{game.status === 'ended'}}" class="card result"><view class="title">{{game.winner}}获胜</view><view>胜负条件已经满足，本局结束。</view></view>

  <block wx:elif="{{game.phase === 'night'}}">
    <view class="host-sheet">
      <view class="host-line main-line">● 天黑请闭眼。</view>
      <view class="host-line">● 狼人请睁眼，确认同伴，狼人商量战术。（狼队：{{wolfMembers}}）</view>
      <view wx:if="{{wolfAlive}}" class="inline-entry"><text>狼人选择刀人目标：</text><picker range="{{aliveLabels}}" value="{{wolfTargetIndex}}" data-field="wolfTarget" bindchange="updateNightTarget"><view class="inline-picker">{{game.night.wolfTarget ? game.night.wolfTarget + '号' : '请选择'}}</view></picker></view>
      <view wx:else class="muted note">狼人阵营已全部出局，仍正常念完本段旁白。</view><view class="host-line">● 狼人闭眼。</view>
      <block wx:if="{{hasGuard}}"><view class="host-line">● 守卫（{{guardNumber}}号）睁眼，请选择今晚要守护的玩家：</view><view wx:if="{{guardAlive}}" class="inline-entry"><picker range="{{aliveLabels}}" value="{{guardTargetIndex}}" data-field="guardTarget" bindchange="updateNightTarget"><view class="inline-picker">{{game.night.guardTarget ? game.night.guardTarget + '号' : '请选择'}}</view></picker><text class="muted">不能连续两晚守同一人</text></view><view wx:else class="muted note">守卫已出局，流程照走，无需记录。</view><view class="host-line">● 守卫闭眼。</view></block>
      <view class="host-line">● 预言家（{{seerNumber}}号）睁眼，预言家验人：</view><view wx:if="{{seerAlive}}" class="inline-entry"><picker range="{{aliveLabels}}" value="{{seerTargetIndex}}" data-field="seerTarget" bindchange="updateNightTarget"><view class="inline-picker">{{game.night.seerTarget ? game.night.seerTarget + '号' : '请选择'}}</view></picker><text wx:if="{{inspection}}" class="inspection-inline">他的身份是：【{{inspection}}】</text></view><view wx:else class="muted note">预言家已出局，流程照走，无需记录。</view><view class="host-line">● 预言家闭眼。</view>
      <view class="host-line">● 女巫（{{witchNumber}}号）睁眼，{{game.resources.antidote ? (game.night.wolfTarget ? '今晚' + game.night.wolfTarget + '号死了。' : '今晚无人倒牌。') : '解药已用，不公布刀口。'}}救人给手势，毒人给数字，摆手不作为：</view><view wx:if="{{witchAlive}}" class="inline-entry witch-entry"><picker range="{{witchActions}}" value="{{witchActionIndex}}" bindchange="selectWitchAction"><view class="inline-picker">{{witchActions[witchActionIndex]}}</view></picker><picker wx:if="{{witchActionIndex === 2}}" range="{{aliveLabels}}" value="{{witchTargetIndex}}" data-field="witchTarget" bindchange="updateNightTarget"><view class="inline-picker">毒{{game.night.witchTarget ? game.night.witchTarget + '号' : '请选择'}}</view></picker><view class="muted">解药：{{game.resources.antidote ? '可用' : '已用'}}　毒药：{{game.resources.poison ? '可用' : '已用'}}</view></view><view wx:else class="muted note">女巫已出局，流程照走，无需记录。</view><view class="host-line">● 女巫闭眼。</view>
    </view><button class="primary finish-button" bindtap="finishNight">夜间行动结束，天亮</button>
  </block>

  <block wx:else>
    <view class="card day-head"><view class="subtitle">天亮了</view><view class="narration">公布昨夜信息后，按当前白天阶段主持。</view><button wx:if="{{selfExposeCandidates.length}}" class="self-expose" bindtap="triggerSelfExpose">狼人自曝</button></view>
    <view wx:if="{{dayMessage}}" class="card warning">{{dayMessage}}</view>

    <button wx:if="{{pendingWolfKingClaw}}" class="claw-button" bindtap="triggerWolfKingClaw">处理狼王爪击</button>
    <view wx:if="{{dayState.stage === 'sheriffSignup'}}" class="card"><view class="subtitle">① 上警</view><view class="muted">点击举手上警的玩家；再次点击可退水。</view><view class="seat-pills"><view wx:for="{{sheriffSignupSeats}}" wx:key="number" class="seat-pill {{item.selected ? 'chosen' : ''}}" data-number="{{item.number}}" bindtap="toggleSheriffCandidate">{{item.number}}号</view></view><view class="button-row"><button bindtap="noSheriff">无人上警，警徽流失</button><button class="primary" bindtap="beginSheriffSpeech">上警名单确认，开始警上发言</button></view></view>
    <view wx:elif="{{dayState.stage === 'sheriffSpeech'}}" class="card"><view class="subtitle">② 警上发言</view><view class="muted">点击仍在警上的号码可记录退水；退水玩家不可参与本轮警长投票。</view><view class="seat-pills"><view wx:for="{{dayState.sheriffCandidates}}" wx:key="*this" class="seat-pill chosen" data-number="{{item}}" bindtap="withdrawSheriffCandidate">{{item}}号 · 退水</view></view><view class="button-row"><button bindtap="returnSheriffSignup">返回重新选择上警玩家</button><button class="primary" bindtap="beginSheriffVote">警上发言结束，进入警长投票</button></view></view>
    <view wx:elif="{{dayState.stage === 'sheriffResumeWithdraw'}}" class="card"><view class="subtitle">退水环节</view><view class="muted">首日警上自曝后，第二天不再进行警上发言，直接记录退水并投警长。</view><view class="seat-pills"><view wx:for="{{dayState.sheriffCandidates}}" wx:key="*this" class="seat-pill chosen" data-number="{{item}}" bindtap="withdrawSheriffCandidate">{{item}}号 · 退水</view></view><button class="primary" bindtap="beginSheriffVote">退水结束，进入警长投票</button></view>
    <view wx:elif="{{dayState.stage === 'sheriffVote'}}" class="card"><view class="subtitle">③ 警长投票</view><view class="muted">可多选警下投票者，再一次记录同一投向。候选人：{{sheriffCandidates.join('、')}}</view><view class="voter-grid"><view wx:for="{{dayVoters}}" wx:key="number" class="voter {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectDayVoter">{{item.number}}号</view></view><picker range="{{voteTargetLabels}}" value="{{selectedVoteTargetIndex}}" bindchange="selectVoteTarget"><view class="picker">投给：{{voteTargetLabels[selectedVoteTargetIndex]}}</view></picker><view class="button-row"><button bindtap="recordVote">记录所选投票者</button><button class="primary" bindtap="resolveSheriffVote">统计警长票</button></view><view wx:for="{{voteRecords}}" wx:key="number" class="vote-row">{{item.number}}号 → {{item.target}}</view><view wx:for="{{voteTally}}" wx:key="number" class="vote-row">{{item.number}}号：{{item.value}}票</view></view>
    <view wx:elif="{{dayState.stage === 'sheriffTie'}}" class="card"><view class="subtitle">警长投票平票</view><view>{{dayMessage}}</view><view class="button-row"><button bindtap="restartSheriffVote">平票玩家再次发言并重投</button><button bindtap="noSheriff">无警长，警徽流失</button></view></view>
    <view wx:elif="{{dayState.stage === 'sheriffOrder'}}" class="card"><view class="subtitle">④ 警长决定发言顺序</view><view>{{sheriffSeat}}号警长请决定从警左还是警右开始发言。</view><view class="button-row"><button class="primary" data-direction="clockwise" bindtap="setSpeakingOrder">顺序发言</button><button data-direction="counterclockwise" bindtap="setSpeakingOrder">逆序发言</button></view></view>
    <view wx:elif="{{dayState.stage === 'announceNight'}}" class="card"><view class="subtitle">公布昨夜信息</view><view class="narration">{{nightDeathText}}</view><view wx:if="{{dayMessage}}" class="warning-text">{{dayMessage}}</view><button class="primary" bindtap="announceNightDeaths">已公布，进入出局技能结算</button></view>
    <view wx:elif="{{dayState.stage === 'selfExposeNight'}}" class="card"><view class="subtitle">自曝流程结束</view><view>请宣布：当前白天流程结束，天黑请闭眼。</view><button class="primary" bindtap="enterSelfExposeNight">进入黑夜</button></view>
    <view wx:elif="{{dayState.stage === 'discussion'}}" class="card"><view class="subtitle">⑤ 白天发言</view><view wx:if="{{sheriffSeat}}">{{sheriffSeat}}号警长已确定发言方向。</view><view wx:else>无警长，请由法官决定发言顺序。</view><button class="primary" bindtap="beginExileVote">发言结束，开始放逐投票</button></view>
    <view wx:elif="{{dayState.stage === 'exileVote'}}" class="card"><view class="subtitle">⑥ 放逐投票</view><view class="mode-switch"><view class="mode-item {{dayState.exileMode === 'individual' ? 'active' : ''}}" data-mode="individual" bindtap="setExileMode">逐票记录</view><view class="mode-item {{dayState.exileMode === 'simple' ? 'active' : ''}}" data-mode="simple" bindtap="setExileMode">简易计票</view></view><block wx:if="{{dayState.exileMode === 'individual'}}"><view class="muted">六角星代表警长票，计为 {{sheriffWeight}} 票。</view><view class="voter-grid"><view wx:for="{{dayVoters}}" wx:key="number" class="voter {{selectedVoterIndex === index ? 'selected' : ''}} {{item.number === sheriffSeat ? 'sheriff-star' : ''}}" data-index="{{index}}" bindtap="selectDayVoter">{{item.number}}号</view></view><picker range="{{voteTargetLabels}}" value="{{selectedVoteTargetIndex}}" bindchange="selectVoteTarget"><view class="picker">投给：{{voteTargetLabels[selectedVoteTargetIndex]}}</view></picker><button bindtap="recordVote">记录此票</button><view wx:for="{{voteRecords}}" wx:key="number" class="vote-row {{item.sheriff ? 'sheriff-record' : ''}}">{{item.sheriff ? '⬡ ' : ''}}{{item.number}}号 → {{item.target}}</view></block><block wx:else><picker range="{{voteTargetLabels}}" value="{{selectedVoteTargetIndex}}" bindchange="selectVoteTarget"><view class="picker">统计 {{voteTargetLabels[selectedVoteTargetIndex]}} 的票数</view></picker><input class="vote-input" type="digit" value="{{simpleVoteCount}}" placeholder="输入票数（可填 1.5）" bindinput="inputSimpleVoteCount"/><button bindtap="recordSimpleVote">记录票数</button></block><view class="tally-title">当前统计</view><view wx:for="{{voteTally}}" wx:key="number" class="vote-row">{{item.number}}号：{{item.value}}票</view><button class="primary" bindtap="resolveExileVote">结束投票并结算放逐</button></view>
    <view wx:elif="{{dayState.stage === 'exileTie'}}" class="card"><view class="subtitle">放逐投票平票</view><view>{{dayMessage}}</view><view class="muted">请法官组织 PK 发言后，选择重新投票或记录本轮无人出局。</view><view class="button-row"><button bindtap="beginExileVote">重新投票</button><button bindtap="recordNoExile">记录无人出局</button></view></view>
    <view wx:elif="{{dayState.stage === 'exileDone'}}" class="card"><view class="subtitle">放逐结算完成</view><button class="primary" bindtap="enterNight">白天结束，进入黑夜</button></view>
  </block>
  </block>

  <view class="card logs"><view class="subtitle">对局记录</view><view wx:for="{{game.logs}}" wx:key="time" class="log-item">{{item.text}}</view></view>
  <view class="card seats"><view class="subtitle">座位状态（仅法官可见）</view><view wx:for="{{seatCards}}" wx:key="number" class="seat-row {{item.alive ? '' : 'dead'}}" data-number="{{item.number}}" bindtap="openSeatInfo"><view><text>{{item.number}}号　{{item.roleName}}</text><text wx:if="{{item.marks.goldWater}}" class="water-tag gold">金水</text><text wx:if="{{item.marks.silverWater}}" class="water-tag silver">银水</text></view><text>{{item.alive ? (item.foolRevealed ? '已翻牌' : '存活') : '出局'}}</text></view></view>
  <view class="card vote-history"><view class="subtitle">投票状态</view><scroll-view scroll-x class="vote-tabs"><view wx:for="{{voteHistory}}" wx:key="id" class="vote-tab {{selectedVoteHistoryIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectVoteHistory">{{item.label}}</view></scroll-view><view wx:if="{{selectedVoteRound}}"><view wx:for="{{selectedVoteRows}}" wx:key="voter" class="vote-row {{item.sheriff ? 'sheriff-record' : ''}}">{{item.sheriff ? '⬡ ' : ''}}{{item.voter}}号 → {{item.target}}</view><view wx:for="{{selectedVoteRound.tally}}" wx:key="number" class="vote-row">{{item.number}}号：{{item.value}}票</view></view><view wx:else class="muted">暂未完成任何一轮投票。</view></view>
  <view wx:if="{{seatInfo}}" class="info-mask" bindtap="closeSeatInfo"><view class="seat-info" catchtap=""><view class="subtitle">{{seatInfo.number}}号牌信息</view><view>身份：{{seatInfo.roleName}}</view><view>状态：{{seatInfo.alive ? '存活' : '出局'}}</view><view wx:if="{{!seatInfo.alive}}">出局原因：{{seatInfo.deathCause}}</view><button bindtap="closeSeatInfo">关闭</button></view></view>
</view>
