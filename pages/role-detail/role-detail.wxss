.role-detail-page { padding-top: 50rpx; }
.role-detail-hero { margin: 0 4rpx 42rpx; }
.source-note { color: var(--color-ink-muted); font-size: 22rpx; line-height: 1.55; }
.role-section { margin-top: 30rpx; padding-top: 23rpx; border-top: 1rpx solid var(--color-border); }
.section-title { margin-bottom: 17rpx; color: var(--color-ink); font-size: 30rpx; font-weight: 600; }
.role-paragraph { margin: 13rpx 0; color: var(--color-ink-secondary); font-size: 28rpx; line-height: 1.75; white-space: pre-wrap; }
.qa-item { margin: 16rpx 0; padding: 20rpx; background: #f7f7f2; }
.question { color: var(--color-ink); font-size: 26rpx; font-weight: 600; line-height: 1.55; }
.answer { margin-top: 11rpx; color: var(--color-ink-secondary); font-size: 24rpx; line-height: 1.68; white-space: pre-wrap; }
