<view class="page role-detail-page" wx:if="{{role}}"><view class="role-detail-hero"><view class="eyebrow">角色专章 · {{role.camp}}</view><view class="title">{{role.name}}</view><view class="source-note">{{sourceNote}}</view></view><view wx:for="{{sections}}" wx:key="title" class="role-section"><view class="section-title">{{item.title}}</view><block wx:if="{{item.isQa}}"><view wx:for="{{item.qas}}" wx:key="question" class="qa-item"><view class="question">问：{{item.question}}</view><view class="answer">答：{{item.answer}}</view></view></block><block wx:else><view wx:for="{{item.paragraphs}}" wx:key="*this" class="role-paragraph">{{item}}</view></block></view></view>
