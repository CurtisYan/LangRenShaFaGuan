page {
  --color-canvas: #f5f5f1;
  --color-surface: #fffefa;
  --color-surface-soft: #f0f0eb;
  --color-ink: #202522;
  --color-ink-secondary: #667067;
  --color-ink-muted: #747970;
  --color-border: #d9dad2;
  --color-primary: #27332f;
  --color-primary-pressed: #35443e;
  --color-on-primary: #fffefa;
  --color-selected: #edf3ed;
  --color-accent: #52695e;
  --color-accent-strong: #30493d;
  --color-accent-muted: #647a70;
  --color-danger: #9a4641;
  --color-danger-soft: #faefed;
  --color-warning: #89652b;
  --color-warning-soft: #f5eddc;
  --color-wolf: #9a514b;
  --color-wolf-soft: #f8efed;
  --color-villager: #58748a;
  --color-villager-soft: #eef4f7;
  --color-god: #89652b;
  --color-god-soft: #fbf8ef;
  --color-third: #80649d;
  --color-third-soft: #f3eff8;
  --radius-control: 12rpx;
  --radius-card: 18rpx;
  --radius-sheet: 22rpx;
  background: var(--color-canvas);
  color: var(--color-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: .01em;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 30rpx 52rpx;
}

.card,
.surface-card {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}

.tap-surface {
  transition: border-color .16s ease, background-color .16s ease, opacity .16s ease, transform .16s ease;
}

.tap-surface:active {
  opacity: .88;
  transform: translateY(1rpx);
}

.list-stack { border-top: 1rpx solid var(--color-border); }
.list-row-base { box-sizing: border-box; border-bottom: 1rpx solid var(--color-border); }

.role-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.role-card {
  box-sizing: border-box;
  border-radius: 14rpx;
}

.title {
  margin-bottom: 12rpx;
  font-size: 46rpx;
  line-height: 1.22;
  font-weight: 600;
  letter-spacing: -.025em;
}

.subtitle {
  margin-bottom: 10rpx;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 600;
}

.eyebrow {
  margin-bottom: 12rpx;
  color: var(--color-ink-muted);
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: .12em;
}

.muted { color: var(--color-ink-muted); }
.danger { color: var(--color-danger); }
.success { color: #3d765c; }

.button-row { display: flex; gap: 14rpx; margin-top: 24rpx; }
.button-row button { flex: 1; }

button {
  box-sizing: border-box;
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 15rpx 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-control);
  color: var(--color-ink);
  background: var(--color-surface);
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 500;
  letter-spacing: .01em;
  text-align: center;
  transition: border-color .14s ease, background-color .14s ease, color .14s ease, opacity .14s ease, transform .14s ease;
}

button::after { border: 0; }
button:active { opacity: .9; transform: translateY(1rpx); }
button.primary { border-color: var(--color-primary); color: var(--color-on-primary); background: var(--color-primary); }
button.primary:active { background: var(--color-primary-pressed); }
button.secondary { border-color: var(--color-border); color: var(--color-ink-secondary); background: var(--color-surface-soft); }
button.quiet,
.quiet-button { border-color: transparent; color: var(--color-ink-secondary); background: transparent; }
button.warn { border-color: var(--color-danger); color: #fffefa; background: var(--color-danger); }
button[disabled] { border-color: var(--color-border); color: var(--color-ink-muted); background: var(--color-surface-soft); opacity: .58; }

.segmented-control {
  display: flex;
  padding: 5rpx;
  border-radius: 14rpx;
  background: var(--color-surface-soft);
}

.segmented-item {
  box-sizing: border-box;
  flex: 1;
  padding: 14rpx 8rpx;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  color: var(--color-ink-secondary);
  font-size: 24rpx;
  line-height: 1.35;
  text-align: center;
}

.segmented-item.active {
  border-color: var(--color-border);
  color: var(--color-ink);
  background: var(--color-surface);
  font-weight: 600;
}

.tag,
.status-chip {
  box-sizing: border-box;
  display: inline-flex;
  min-height: 34rpx;
  align-items: center;
  margin: 5rpx 8rpx 5rpx 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: var(--color-ink-secondary);
  background: var(--color-surface-soft);
  font-size: 22rpx;
  line-height: 1.35;
}

.field { margin: 22rpx 0; }
.label { display: block; margin-bottom: 10rpx; color: var(--color-ink-secondary); font-size: 24rpx; }
.picker {
  box-sizing: border-box;
  min-height: 78rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-control);
  color: var(--color-ink);
  background: var(--color-surface);
  line-height: 1.45;
}
