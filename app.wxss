page {
  background: #f3f4f6;
  color: #111827;
  font-size: 30rpx;
}

.page { padding: 28rpx; }
.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #fff;
}
.title { margin-bottom: 16rpx; font-size: 40rpx; font-weight: 700; }
.subtitle { margin-bottom: 12rpx; font-size: 32rpx; font-weight: 600; }
.muted { color: #6b7280; }
.danger { color: #b91c1c; }
.success { color: #047857; }
.button-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.button-row button { flex: 1; }
button { border-radius: 12rpx; }
button.primary { color: #fff; background: #2563eb; }
button.warn { color: #fff; background: #b91c1c; }
.tag {
  display: inline-block;
  margin: 6rpx 8rpx 6rpx 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  font-size: 25rpx;
}
.field { margin: 20rpx 0; }
.label { display: block; margin-bottom: 8rpx; color: #4b5563; }
.picker {
  min-height: 48rpx;
  padding: 18rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 10rpx;
  background: #fff;
}
