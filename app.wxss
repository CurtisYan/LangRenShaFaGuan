page {
  background: #f5f5f1;
  color: #202522;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 29rpx;
  letter-spacing: .01em;
}

.page { box-sizing: border-box; min-height: 100vh; padding: 36rpx 30rpx 52rpx; }
.card {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e2e2da;
  border-radius: 20rpx;
  background: #fffefa;
}
.title { margin-bottom: 12rpx; font-size: 46rpx; line-height: 1.22; font-weight: 650; letter-spacing: -.025em; }
.subtitle { margin-bottom: 10rpx; font-size: 31rpx; line-height: 1.35; font-weight: 600; }
.eyebrow { margin-bottom: 12rpx; color: #777b73; font-size: 22rpx; font-weight: 600; letter-spacing: .14em; }
.muted { color: #747970; }
.danger { color: #a64743; }
.success { color: #3d765c; }
.button-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.button-row button { flex: 1; }
button {
  box-sizing: border-box;
  min-height: 82rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #d7d8d0;
  border-radius: 14rpx;
  color: #303632;
  background: #fffefa;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 80rpx;
}
button::after { border: 0; }
button.primary { border-color: #27332f; color: #fffefa; background: #27332f; }
button.warn { border-color: #9a4641; color: #fffefa; background: #9a4641; }
button[disabled] { border-color: #e6e6df; color: #adb0a8; background: #f0f0eb; }
.tag {
  display: inline-block;
  margin: 6rpx 8rpx 6rpx 0;
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  background: #ecece5;
  font-size: 22rpx;
  line-height: 1.35;
}
.field { margin: 22rpx 0; }
.label { display: block; margin-bottom: 10rpx; color: #5f665e; font-size: 25rpx; }
.picker {
  min-height: 46rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid #d8d9d1;
  border-radius: 12rpx;
  color: #303632;
  background: #fffefa;
}
